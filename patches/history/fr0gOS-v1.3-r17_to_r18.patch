+// fr0gOS: the flight controller's VTX settings win. A VTX that couldn't reach the FC at power-up falls back to
+// its own last channel (R1) and then reports that back with MSP_SET_VTX_CONFIG, which Betaflight adopts and
+// saves, so the quad stays stuck on the wrong channel. Settings coming from the VTX's own port are ignored and
+// the FC's settings are pushed back instead (the configurator and the OSD menu still change them as normal).
+bool mspVtxIsVtxPort(const int descriptor)
+{
+    return mspVtxPortIdentifier != 255 && getMspSerialPortDescriptor(mspVtxPortIdentifier) == descriptor;
+}
+
+void mspVtxPushConfig(void)
+{
+    mspVtxConfigChanged = true;
+}
+
 void prepareMspFrame(uint8_t *mspFrame)
 {
     mspFrame[0] = VTXDEV_MSP;
