+// fr0gOS labelled readouts: a label on the element's row, the value on the row below
+static bool frogLabelled(osdElementParms_t *element, const char *label, void (*value)(osdElementParms_t *))
+{
+    static uint8_t lastItem = 0xFF;
+    static bool second = false;
+    if (lastItem != element->item) {
+        lastItem = element->item;
+        second = false;
+    }
+    if (!second) {
+        strcpy(element->buff, label);
+        second = true;
+        element->rendered = false;              // come back for the value
+        return true;
+    }
+    second = false;
+    lastItem = 0xFF;
+    element->elemOffsetY = 1;
+    value(element);
+    return false;
+}
+
+static void osdElementThrottlePosition(osdElementParms_t *element)
+{
+    frogLabelled(element, "THR", osdElementThrottleValue);
+}
+
+static void osdElementEscRpm(osdElementParms_t *element)
+{
+    frogLabelled(element, "RPM", osdElementEscRpmValue);
+}
