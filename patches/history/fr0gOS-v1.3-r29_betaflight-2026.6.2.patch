+// r29: a trick has to be flown - the sticks asking for that axis for most of it - so a tumble never counts.
+// (ORBIT and TRIPY are gone: without GPS they can't be told from a wide turn.)
+#define FROG_LOOP_MS         700
+#define FROG_LOOP_THR        45
