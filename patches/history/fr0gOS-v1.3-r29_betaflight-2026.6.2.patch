+// ---- tricks and crashes, watched at IMU rate (the OSD itself only looks ~10-20 times a second) ----
+// A trick is 300 degrees one way on one axis (a "full" 360 with some slack), started and finished within 3 s.
+// It keeps counting through a slow patch of up to 0.5 s; turning back the other way hard starts it over.
+#define FROG_TRICK_DEG       300.0f
+#define FROG_TRICK_RATE      100.0f     // deg/s to count as turning
+#define FROG_TRICK_SLOW_MS   500
+#define FROG_TRICK_MAX_MS    3000
+// r29: crash, clip and perch from the physics, not from G alone.
+// The accelerometer feels every push on the quad except gravity. In the air the only push is the props, and
+// prop thrust goes with RPM squared (bidirectional DShot), so  contact = accel - thrust  is ~0 G the whole time
+// it's flying, however hard you fly. Anything left over is something touching the quad. The thrust scale is
+// learned while flying (throttle 35%+ for a while, not rotating hard, little sideways G).
+// Rotation the sticks didn't ask for (gyro beyond anything the setpoint asked in the last ~0.2 s) is the
+// other tell: you did it = trick, something else did it = a hit.
+//   HIT    contact 2.5 G+ (3.8 G raw accel before the scale is learned), or 600 deg/s+ unasked rotation.
+//          Then for up to 2 s:
+//   CRASH  tumbling (500 deg/s+ unasked for 0.2 s), or it comes to rest upside down / on its side, or rests
+//          after a 6 G+ hit, or it's still stuck against something at the end, or you disarm / turtle while
+//          it isn't sitting upright and still
+//   PERCH  it comes to rest upright after a lighter hit (a firm landing)
+//   CLIP   it flew on: props carrying it again with no contact for 0.3 s after a real contact hit
+//   PERCH  (no hit) settles upright on something with the motors near idle for 0.5 s: in the air, idle props
+//          mean free fall (~0 G), so 1 G with idle props can only be something holding it up
+#define FROG_HIT_G           2.5f
+#define FROG_HIT_RAW_G       3.8f
+#define FROG_SMASH_G         6.0f
+#define FROG_WILD_DPS        600.0f
+#define FROG_TUMBLE_DPS      500.0f
+#define FROG_TUMBLE_MS       200
+#define FROG_HIT_LOOK_MS     2000
+#define FROG_REST_DPS        60.0f
+#define FROG_REST_MS         300
+#define FROG_PERCH_MS        500
+#define FROG_IDLE_G          0.35f
+#define FROG_FLY_G           0.6f
+#define FROG_AIR_CONTACT_G   0.4f
+#define FROG_STUCK_G         0.6f
