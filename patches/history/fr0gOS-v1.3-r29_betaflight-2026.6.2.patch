+// ---------------- stick code ----------------
+// The stick positions, written into the bottom row as dim three-band glyphs (3 bits each) so the goggles' DVR
+// carries them and tools/stickcode_decode.py can read them back off the video for a stick overlay. 10 cells:
+// left  [count][roll hi][roll lo][pitch hi][pitch lo]   right [yaw hi][yaw lo][thr hi][thr lo][check]
+// Each stick is 6 bits (1000-2000 us -> 0-63). count goes up every frame; check = (sum of the other nine + 5) & 7.
+static const uint8_t frogStickGlyph[8] = FROG_STICK_GLYPHS;
+static void frogStickCodeLine(char *b, bool hd, bool right)
+{
+    static uint8_t cells[10];
+    static uint8_t count = 0;
+    b[0] = '\0';
+    if (!hd) {
+        return;
+    }
+    if (!right) {
+        static const uint8_t ch[4] = { ROLL, PITCH, YAW, THROTTLE };
+        cells[0] = count++ & 7;
+        for (int i = 0; i < 4; i++) {
+            const int v = constrain(lrintf((rcData[ch[i]] - 1000.0f) * 63.0f / 1000.0f), 0, 63);
+            cells[1 + 2 * i] = (v >> 3) & 7;
+            cells[2 + 2 * i] = v & 7;
+        }
+        uint8_t sum = 0;
+        for (int i = 0; i < 9; i++) {
+            sum += cells[i];
+        }
+        cells[9] = (sum + 5) & 7;        // +5: an all-black row never reads as valid
+    }
+    for (int i = 0; i < 5; i++) {
+        b[i] = (char)frogStickGlyph[cells[(right ? 5 : 0) + i]];
+    }
+    b[5] = '\0';
+}
