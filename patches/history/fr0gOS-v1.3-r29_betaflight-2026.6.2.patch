+        deg[0] = deg[1] = deg[2] = 0.0f;
+        last = 0;
+        frogMotionArmedAt = 0;
+        frogThrustK = 0.0f;
+        return;
+    }
+    if (!frogMotionArmedAt) {
+        frogMotionArmedAt = nowUs ? nowUs : 1;
+        frogMotionFresh = true;
+    }
+    if (frogMotionFresh) {                       // just armed: on the ground, not perched anywhere new yet
+        perched = true;
+        airborne = false;
+        hitAt = restSince = stillSince = flySince = airSince = thrUpSince = 0;
+        frogMotionFresh = false;
+    }
+    const float dt = last ? cmpTimeUs(nowUs, last) * 1e-6f : 0.0f;
+    last = nowUs;
+    if (dt <= 0.0f || dt > 0.1f) {
+        deg[0] = deg[1] = deg[2] = 0.0f;
+        return;
+    }
+    const int thr = calculateThrottlePercent();
