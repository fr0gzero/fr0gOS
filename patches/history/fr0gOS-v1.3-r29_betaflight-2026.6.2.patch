+        if (!loop) {
+            return a->f[a->n - 1].g;
+        }
+        ms %= total;
+    }
+    for (int i = 0; i < a->n; i++) {
+        const uint32_t t = a->f[i].t10 * 10;
+        if (ms < t) {
+            return a->f[i].g;
+        }
+        ms -= t;
+    }
+    return a->f[a->n - 1].g;
