+// Red noise for the power side: a red block on HD, plain noise on analog
+uint8_t frogFlipNoiseChar(bool hd)
+{
+    // crash-flip noise: red blocks and red/amber characters on HD, plain noise on analog
+    if (!hd) {
+        return frogNoiseChar(false);
+    }
+    const uint32_t r = frogRand();
+    if (r & 1) {
+        return FROG_GLYPH_RSCRAMBLE1 + (r >> 1) % 3;
+    }
+    return frogColourNoiseChar((r & 2) ? DISPLAYPORT_SEVERITY_WARNING : DISPLAYPORT_SEVERITY_CRITICAL);
+}
+static uint8_t frogRedNoiseChar(bool hd)
+{
+    const uint32_t r = frogRand();
+    if (hd) {
+        return (r & 1) ? (FROG_GLYPH_RSCRAMBLE1 + (r >> 1) % 3) : frogColourNoiseChar(DISPLAYPORT_SEVERITY_CRITICAL);
+    }
+    return frogNoiseChar(false);
+}
+// Voltage sag in centivolts per cell: how far the cell voltage is below its recent peak.
+// The peak holds and decays 1 cV every 150 ms, so throttle punches show up as sag, slow discharge doesn't.
+static uint16_t frogSagCv(void)
+{
+    static uint16_t peak = 0;
+    static timeMs_t lastDecay = 0;
+    const uint16_t v = getBatteryAverageCellVoltage();
+    const timeMs_t now = millis();
+    if (v > peak || !ARMING_FLAG(ARMED)) {
+        peak = v;
+    } else if (now - lastDecay >= 150 && peak > v) {
+        peak--;
+        lastDecay = now;
+    }
+    return peak > v ? peak - v : 0;
+}
+// Battery noise: noise characters creep into the black bars as the pack gets worse, so you can feel it
+// without reading numbers. Four stages, escalating in colour and amount:
+//   SAG   voltage dips under load (0.20 V/cell+)   green, 1-4 chars
+//   LOW   below vbat_warning_cell_voltage           amber, 4 chars (+ sag)
+//   LAND  below vbat_min_cell_voltage               red,   8 chars (+ sag)
+//   DEAD  0.30 V/cell under the minimum             red,  14 chars, flickering every frame
+// Drawn first in the display order so the telemetry is written over it and stays readable.
+// Called repeatedly per frame (rendered = false), one character per call.
+static frogBattStage_e frogBattStage(uint8_t *count)
+{
+    const uint16_t cell = getBatteryAverageCellVoltage();
+    const uint16_t sag = ARMING_FLAG(ARMED) ? frogSagCv() : 0;
+    const uint8_t sagChars = sag >= 20 ? MIN(4, (sag - 20) / 8 + 1) : 0;
+    const batteryState_e batt = getBatteryState();
+    if (batt == BATTERY_NOT_PRESENT || batt == BATTERY_INIT || cell == 0) {
+        *count = 0;
+        return FROG_BATT_OK;
+    }
+    if (cell + 30 <= currentBatteryProfile->vbatmincellvoltage) {
+        *count = 14;
+        return FROG_BATT_DEAD;
+    }
+    if (batt == BATTERY_CRITICAL) {
+        *count = 8 + sagChars;
+        return FROG_BATT_LAND;
+    }
+    if (batt == BATTERY_WARNING) {
+        *count = 4 + sagChars;
+        return FROG_BATT_LOW;
+    }
+    *count = sagChars;
+    return sagChars ? FROG_BATT_SAG : FROG_BATT_OK;
 }
 
+static void osdElementFrogGlitch(osdElementParms_t *element)
+{
+    static uint8_t remaining = 0;
+    static frogBattStage_e stage = FROG_BATT_OK;
+    static bool frameStarted = false;
+    const bool hd = frogHdFont(element->osdDisplayPort);
+    const uint8_t cols = element->osdDisplayPort->cols;
+    const uint8_t rows = element->osdDisplayPort->rows;
+
+    if (!frameStarted) {
+        stage = frogBattStage(&remaining);
+        if (!hd) {
+            remaining = 0;          // analog: nothing in empty space; the battery % glitches instead
+        }
+        frameStarted = true;
+    }
+    if (remaining == 0 || cols < 20) {
+        frameStarted = false;
+        element->buff[0] = '\0';
+        return;
+    }
+    // bar width: 5 columns each side stays inside the HD black bars; analog uses the outer 4
+    const uint8_t bar = hd ? 5 : 4;
+    const uint32_t r = frogRand();
+    const uint8_t col = r % (bar * 2);
+    element->elemOffsetX = (col < bar) ? col : (cols - bar * 2 + col);
+    element->elemOffsetY = (r >> 8) % rows;
+    uint8_t c;
+    switch (stage) {
+    case FROG_BATT_LOW:
+        c = hd ? frogColourNoiseChar(DISPLAYPORT_SEVERITY_WARNING) : frogNoiseChar(false);
+        break;
+    case FROG_BATT_LAND:
+    case FROG_BATT_DEAD:
+        c = frogRedNoiseChar(hd);
+        break;
+    default:
+        c = frogNoiseChar(hd);
+        break;
+    }
+    element->buff[0] = (char)c;
+    element->buff[1] = '\0';
+    if (--remaining > 0) {
+        element->rendered = false;
+    } else {
+        frameStarted = false;
+    }
+}
