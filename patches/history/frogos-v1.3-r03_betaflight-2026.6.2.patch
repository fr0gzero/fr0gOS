+static void frogRainReset(int i, int rows)
+{
+    frogRainHead[i] = -(int8_t)(frogRand() % (rows + 4));
+    frogRainLen[i] = 3 + frogRand() % 5;
+}
+
+static void frogRainDraw(void)
+{
+    static const char digits[] = "0123456789ABCDEFXZ$#";
+    const bool hd = frogHdFont(osdDisplayPort);
+    const int rows = osdDisplayPort->rows;
+    const int cols = osdDisplayPort->cols;
+    const int bar = hd ? 5 : 4;      // HD: 5 columns each side stays inside the black bars
+
+    displayClearScreen(osdDisplayPort, DISPLAY_CLEAR_NONE);
+    for (int i = 0; i < bar * 2; i++) {
+        frogRainHead[i]++;
+        if (frogRainHead[i] - frogRainLen[i] >= rows) {
+            frogRainReset(i, rows);
+        }
+    }
+    for (int y = 0; y < rows; y++) {
+        for (int side = 0; side < 2; side++) {
+            char seg[8];
+            bool any = false;
+            for (int k = 0; k < bar; k++) {
+                const int i = side * bar + k;
+                const int d = frogRainHead[i] - y;          // 0 = the falling head
+                char c = ' ';
+                if (d >= 0 && d < frogRainLen[i]) {
+                    if (d >= 2 && hd) {
+                        c = (char)(FROG_GLYPH_SCRAMBLE1 + frogRand() % 3);   // dark green trail
+                    } else {
+                        c = digits[frogRand() % (sizeof(digits) - 1)];       // bright head
+                    }
+                    any = true;
+                }
+                seg[k] = c;
+            }
+            seg[bar] = '\0';
+            if (any) {
+                displayWrite(osdDisplayPort, side ? cols - bar : 0, y, DISPLAYPORT_SEVERITY_NORMAL, seg);
+            }
+        }
+    }
