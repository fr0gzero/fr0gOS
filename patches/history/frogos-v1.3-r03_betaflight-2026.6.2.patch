+    memcpy(hb, header, typed);
+    hb[typed] = (typed < sizeof(header) - 1) ? (char)(hd ? FROG_GLYPH_CURSOR : '_') : '\0';
+    hb[typed + 1] = '\0';
+    displayWrite(osdDisplayPort, x, y++, DISPLAYPORT_SEVERITY_NORMAL, hb);
