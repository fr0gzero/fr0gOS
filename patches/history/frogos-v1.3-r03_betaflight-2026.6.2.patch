+// animated frog + craft name (right top): blinks now and then, croaks while a warning is up
+static void osdElementFrogCraft(osdElementParms_t *element)
+{
+    char name[MAX_NAME_LENGTH + 1];
+    if (strlen(pilotConfig()->craftName) == 0) {
+        strcpy(name, "FROGOS");
+    } else {
+        toUpperCase(name, pilotConfig()->craftName, MAX_NAME_LENGTH);
+    }
+    if (!frogHdFont(element->osdDisplayPort)) {
+        strcpy(element->buff, name);
+        return;
+    }
+    const timeMs_t now = millis();
+    uint8_t frog = FROG_GLYPH_FROG_IDLE;
+    const batteryState_e batt = getBatteryState();
+    bool upsideDown = isCrashFlipModeActive();                      // turtle mode
+#if defined(USE_ACC)
+    upsideDown = upsideDown || (sensors(SENSOR_ACC) && getCosTiltAngle() < 0.0f);   // tilted past 90 degrees
+#endif
+    if (upsideDown) {
+        frog = FROG_GLYPH_FROG_FLIP;                                   // quad upside down: frog on its back
+    } else if (ARMING_FLAG(ARMED) && osdGForce >= FROG_HIGH_G) {
+        frog = ((now / 120) % 2) ? FROG_GLYPH_FROG_SQUASH1 : FROG_GLYPH_FROG_SQUASH2;   // pulling G: squashed flat
+    } else if (batt == BATTERY_WARNING || batt == BATTERY_CRITICAL) {
+        frog = ((now / 300) % 2) ? FROG_GLYPH_FROG_SWEAT1 : FROG_GLYPH_FROG_SWEAT2;
+    } else if (frogWarnSeverity >= DISPLAYPORT_SEVERITY_WARNING) {
+        frog = ((now / 250) % 2) ? FROG_GLYPH_FROG_CROAK : FROG_GLYPH_FROG_IDLE;
+    } else if ((now % 3700) < 160) {
+        frog = FROG_GLYPH_FROG_BLINK;
+    }
+    // the frog is the dash: MK4<frog>2
+    const size_t n = strlen(name);
+    if (n >= 2) {
+        memcpy(element->buff, name, n - 1);
+        element->buff[n - 1] = (char)frog;
+        element->buff[n] = name[n - 1];
+        element->buff[n + 1] = '\0';
+    } else {
+        element->buff[0] = (char)frog;
+        strcpy(&element->buff[1], name);
+    }
+}
