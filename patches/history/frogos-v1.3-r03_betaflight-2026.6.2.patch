+static void osdElementFrogBattPct(osdElementParms_t *element)
+{
+    // charge-up: the first second the OSD is up, % counts up and the bar fills like a boot meter
+    static timeMs_t firstShownMs = 0;
+    const timeMs_t now = millis();
+    if (firstShownMs == 0) {
+        firstShownMs = now ? now : 1;
+    }
+    const uint32_t sinceMs = now - firstShownMs;
+    uint8_t pct = calculateBatteryPercentageRemaining();
+    if (sinceMs < 1000) {
+        pct = (uint8_t)((pct * sinceMs) / 1000);
+    }
+    tfp_sprintf(element->buff, "%d%%", pct);
+    if (frogHdFont(element->osdDisplayPort)) {
+        const uint8_t level = pct >= 88 ? 4 : pct >= 63 ? 3 : pct >= 38 ? 2 : pct >= 13 ? 1 : 0;
+        const size_t len = strlen(element->buff);
+        element->buff[len] = (char)(FROG_GLYPH_BATT0 + level);
+        element->buff[len + 1] = '\0';
+    }
+    switch (getBatteryState()) {
+    case BATTERY_WARNING:  element->attr = DISPLAYPORT_SEVERITY_WARNING;  break;
+    case BATTERY_CRITICAL: element->attr = DISPLAYPORT_SEVERITY_CRITICAL; break;
+    default: break;
+    }
+    // analog: no noise in the bars, so at LAND / DEAD the % itself glitches one character, briefly
+    if (!frogHdFont(element->osdDisplayPort) && element->buff[0]) {
+        uint8_t count;
+        const frogBattStage_e st = frogBattStage(&count);
+        const uint32_t period = st == FROG_BATT_DEAD ? 500 : 1500;
+        if (st >= FROG_BATT_LAND && (now % period) < 120) {
+            element->buff[frogRand() % strlen(element->buff)] = (char)frogNoiseChar(false);
+        }
+    }
+}
