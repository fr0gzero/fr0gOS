+
+    // the new-record value flashes amber/red
+    const uint8_t flash = ((ms / 250) % 2) ? DISPLAYPORT_SEVERITY_WARNING : DISPLAYPORT_SEVERITY_CRITICAL;
+
+    y++;                                                  // blank line under the header
+    if (anyNew) {
+        if (FROG_SHOW()) {
+            // NEW HIGH SCORE: decodes in, then the colours chase along it; frogs hop in the flanks
+            static const char text[] = "NEW HIGH SCORE";
+            const uint32_t bm = ms - 350;
+            char b[32];
+            int n = 0;
+            const int hop = (ms / 150) % 3;
+            for (int k = 0; k < 3; k++) {
+                if (hd) {
+                    b[n++] = (k == hop) ? (char)(((ms / 300) % 2) ? FROG_GLYPH_FROG_CROAK : FROG_GLYPH_FROG_IDLE) : ' ';
+                } else {
+                    b[n++] = (k == hop) ? '>' : ' ';
+                }
+            }
+            b[n++] = ' ';
+            for (unsigned i = 0; i < sizeof(text) - 1; i++) {
+                char c = text[i];
+                if (bm < 40 * i + 200 && c != ' ') {
+                    c = (char)frogNoiseChar(hd);
+                } else if (hd && c != ' ') {
+                    static const uint8_t chase[3] = { DISPLAYPORT_SEVERITY_NORMAL, DISPLAYPORT_SEVERITY_WARNING, DISPLAYPORT_SEVERITY_CRITICAL };
+                    c = (char)frogColourChar((uint8_t)c, chase[(i + ms / 80) % 3]);
