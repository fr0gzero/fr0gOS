+// FrogOS appear / vanish: whenever a readout appears on the main screen it decodes in through a brief
+// flash of glyphs, and when it disappears it dissolves out the same way. Live numbers never go blank,
+// so they only do this when the whole OSD comes back (after boot, arming, HISCORE, screensaver).
+// Effects stay inside the element's own text, so on analog nothing lands in empty space.
+#define FROG_APPEAR_MS 260
+#define FROG_VANISH_MS 260
+#define FROG_FX_TEXT 9
+static char frogFxLast[OSD_ITEM_COUNT][FROG_FX_TEXT];
+static bool frogFxShown[OSD_ITEM_COUNT];
+static timeMs_t frogFxAppearAt[OSD_ITEM_COUNT];
+static timeMs_t frogFxVanishAt[OSD_ITEM_COUNT];
+
+void frogAppearReset(void)
+{
+    for (int i = 0; i < OSD_ITEM_COUNT; i++) {
+        frogFxShown[i] = false;
+        frogFxVanishAt[i] = 0;
+    }
+}
+
+static bool frogTextBlank(const char *s)
+{
+    for (; *s; s++) {
+        if (*s != ' ') {
+            return false;
+        }
+    }
+    return true;
+}
+
+static void frogAppearFx(uint8_t item, osdElementParms_t *element)
+{
+    if (item >= OSD_ITEM_COUNT || item == OSD_FROG_GLITCH || element->elemOffsetX || element->elemOffsetY) {
+        return;
+    }
+    const bool hd = frogHdFont(element->osdDisplayPort);
+    const timeMs_t now = millis();
+    const bool blank = !element->drawElement || frogTextBlank(element->buff);
+    const size_t len = blank ? 0 : strlen(element->buff);
+    if (len >= FROG_FX_TEXT) {
+        frogFxShown[item] = true;               // long elements (stick overlay etc.) don't take part
+        return;
+    }
+    if (!blank) {
+        if (!frogFxShown[item]) {
+            frogFxAppearAt[item] = now ? now : 1;
+            frogFxVanishAt[item] = 0;
+        }
+        frogFxShown[item] = true;
+        memcpy(frogFxLast[item], element->buff, len + 1);
+    } else if (frogFxShown[item]) {
+        frogFxShown[item] = false;
+        frogFxVanishAt[item] = now ? now : 1;
+        frogFxAppearAt[item] = 0;
+    }
+
+    if (frogFxAppearAt[item]) {
+        const uint32_t t = now - frogFxAppearAt[item];
+        if (t >= FROG_APPEAR_MS) {
+            frogFxAppearAt[item] = 0;
+        } else {
+            for (size_t i = 0; element->buff[i]; i++) {
+                if (element->buff[i] != ' ' && t < 35 * i + 90) {
+                    element->buff[i] = (char)frogNoiseChar(hd);
+                }
+            }
+        }
+    } else if (frogFxVanishAt[item]) {
+        const uint32_t t = now - frogFxVanishAt[item];
+        if (t >= FROG_VANISH_MS) {
+            frogFxVanishAt[item] = 0;
+        } else {
+            // the old text turns to glyphs, then the glyphs drop out one by one
+            const char *ghost = frogFxLast[item];
+            size_t i = 0;
+            for (; ghost[i]; i++) {
+                element->buff[i] = (ghost[i] == ' ' || t >= 120 + 35 * i) ? ' ' : (char)frogNoiseChar(hd);
+            }
+            element->buff[i] = '\0';
+            element->drawElement = true;
+            element->attr = DISPLAYPORT_SEVERITY_NORMAL;
+        }
+    }
+}
