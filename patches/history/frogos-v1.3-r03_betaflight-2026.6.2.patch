+// ---------------- FrogOS boot screen ----------------
+#define FROGOS_VERSION   "V1.3 R03"
+#define FROG_BOOT_WIDTH  22
+#define FROG_BOOT_LINES  9
+
+static bool frogBootActive = false;
+static timeUs_t frogBootNextDrawUs = 0;
+static timeUs_t frogBootStartUs = 0;
+static int frogBootLineNo = 0;
+#define FROG_BOOT_STEP_MS 420   // one boot line: types out, spins, then reports
+#define FROG_BOOT_TYPE_MS 250   // time spent typing a line
+
+static void frogUpper(char *s)
+{
+    for (; *s; s++) {
+        *s = toupper((unsigned char)*s);
+    }
+}
+
+// write the first part of a line as if it is being typed, with the cursor in front
+static void frogBootTypeOut(int x, int y, const char *line, size_t typedLen, uint32_t t)
+{
+    char buf[FROG_BOOT_WIDTH + 2];
+    size_t n = (typedLen * t) / FROG_BOOT_TYPE_MS;
+    if (n > typedLen) {
+        n = typedLen;
+    }
+    memcpy(buf, line, n);
+    buf[n] = frogHdFont(osdDisplayPort) ? (char)FROG_GLYPH_CURSOR : '_';
+    buf[n + 1] = '\0';
+    displayWrite(osdDisplayPort, x, y, DISPLAYPORT_SEVERITY_NORMAL, buf);
+}
+
+// "LBL  detail ........ STAT" padded to FROG_BOOT_WIDTH
+static void frogBootLine(int x, int y, const char *label, const char *detail, const char *status)
+{
+    // BIOS-style reveal: line N types itself out, spins, then reports
+    const int idx = ++frogBootLineNo;
+    const uint32_t ms = (micros() - frogBootStartUs) / 1000;
+    if (ms < (uint32_t)idx * FROG_BOOT_STEP_MS) {
+        return;
+    }
+    const uint32_t t = ms - (uint32_t)idx * FROG_BOOT_STEP_MS;
+    char spin[2] = { "|/-\\"[(ms / 80) % 4], '\0' };
+    const bool typing = t < FROG_BOOT_TYPE_MS;
+    const bool running = t < FROG_BOOT_STEP_MS;
+    if (running) {
+        status = typing ? " " : spin;
+    }
+    char line[FROG_BOOT_WIDTH + 1];
+    memset(line, '.', FROG_BOOT_WIDTH);
+    line[FROG_BOOT_WIDTH] = '\0';
+
+    // label padded to 4, then detail (tfp_sprintf has no %-4s)
+    char head[FROG_BOOT_WIDTH + 1];
+    memset(head, ' ', sizeof(head));
+    const size_t labelLen = MIN(strlen(label), (size_t)4);
+    memcpy(head, label, labelLen);
+    const size_t detailLen = MIN(strlen(detail), (size_t)(FROG_BOOT_WIDTH - 6));
+    memcpy(&head[5], detail, detailLen);
+    head[5 + detailLen + (detailLen ? 1 : 0)] = '\0';
+    frogUpper(head);
+    size_t headLen = strlen(head);
+    const size_t statLen = strlen(status);
+    if (headLen > FROG_BOOT_WIDTH - statLen - 1) {
+        headLen = FROG_BOOT_WIDTH - statLen - 1;
+    }
+    memcpy(line, head, headLen);
+    line[FROG_BOOT_WIDTH - statLen - 1] = ' ';
+    memcpy(&line[FROG_BOOT_WIDTH - statLen], status, statLen);
+    if (typing) {
+        frogBootTypeOut(x, y, line, FROG_BOOT_WIDTH - statLen - 1, t);
+        return;
+    }
+    if (frogHdFont(osdDisplayPort) && !running) {
+        const uint8_t sev = (strcmp(status, "OK") == 0 || strcmp(status, "--") == 0 || status[0] == '#') ? DISPLAYPORT_SEVERITY_NORMAL
+                          : strcmp(status, "FAIL") == 0 ? DISPLAYPORT_SEVERITY_CRITICAL
+                          : DISPLAYPORT_SEVERITY_WARNING;
+        frogColourise(&line[FROG_BOOT_WIDTH - statLen], sev);
+    }
+    displayWrite(osdDisplayPort, x, y, DISPLAYPORT_SEVERITY_NORMAL, line);
+}
+
+static void osdFrogDrawBootStatus(void)
+{
+    frogBootLineNo = 0;
+    const int rows = osdDisplayPort->rows;
+    const int midRow = rows / 2;
+    const int x = (osdDisplayPort->cols / 2) - (FROG_BOOT_WIDTH / 2);
+    int y = midRow - 5 + frogLogoRows() + 1;
+    if (y + FROG_BOOT_LINES > rows) {
+        y = rows - FROG_BOOT_LINES;
+    }
+    char detail[16];
+
+    // header: FROGOS V1.0 R01 ..... MK4-1
+    char head[FROG_BOOT_WIDTH + 1];
+    char craft[MAX_NAME_LENGTH + 1];
+    strncpy(craft, pilotConfig()->craftName, MAX_NAME_LENGTH);
+    craft[MAX_NAME_LENGTH] = '\0';
+    frogUpper(craft);
+    memset(head, ' ', FROG_BOOT_WIDTH);
