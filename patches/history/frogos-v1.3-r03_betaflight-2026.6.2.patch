+            for (int i = 0; hd && i < 6; i++) {
+                const uint32_t r = frogRand();
+                static const char sparks[] = "X.!%";   // all have amber/red copies
+                char sp[2] = { sparks[r % 4], '\0' };
+                if (hd) {
+                    sp[0] = (char)frogColourChar((uint8_t)sp[0], (r & 0x10) ? DISPLAYPORT_SEVERITY_WARNING : DISPLAYPORT_SEVERITY_CRITICAL);
+                }
+                const int col = (r >> 5) % (bar * 2);
+                displayWrite(osdDisplayPort, col < bar ? col : cols - bar * 2 + col, (r >> 12) % rows, DISPLAYPORT_SEVERITY_NORMAL, sp);
