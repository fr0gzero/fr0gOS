+    int lines = 1 + (anyNew ? 3 : 1) + (newG ? 3 : 2) + 1 + 1 + 2 + 1;
+    // short screens (analog, 13 rows): drop blank lines until it fits
+    const bool tightBanner = lines > rows;
+    lines -= tightBanner ? 1 : 0;
+    const bool tightFooter = lines > rows;
+    lines -= tightFooter ? 1 : 0;
+    int y = MAX(0, (rows - lines) / 2);
+
+    displayClearScreen(osdDisplayPort, DISPLAY_CLEAR_NONE);
+
+    // header types out, then the listing prints one line every 90 ms
+    static const char header[] = "C:\\FR0G> HISCORE.EXE";
+    char hb[sizeof(header) + 1];
