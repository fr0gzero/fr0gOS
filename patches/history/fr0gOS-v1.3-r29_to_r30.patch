+float frogThrustProxyFilt = 0.0f;           // fr0gOS: frogThrustProxy through the accel's own low-pass
 float frogThrustK = 0.0f;                   // fr0gOS: prop thrust scale, G per unit of frogThrustProxy (0 = not learned)
 float frogContactPeakG = 0.0f;              // fr0gOS: peak |accel - thrust| since the frog last looked
