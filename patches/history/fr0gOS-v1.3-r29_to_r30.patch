@@ -147,8 +148,18 @@ static inline void postProcessAccelerometer(void)
     {
         // fr0gOS: contact force = everything the accelerometer feels that the props don't explain
         const float cx = acc.accADC.v[X] * acc.dev.acc_1G_rec, cy = acc.accADC.v[Y] * acc.dev.acc_1G_rec;
+        // r30: the thrust goes through the same filter as the accel, so a punch or a chop can't open a gap
+        // between them that looks like a hit
+        static pt2Filter_t thrustFilter;
+        static float thrustFilterHz = -1.0f;
+        if (thrustFilterHz != accelerationRuntime.accLpfCutHz) {
+            thrustFilterHz = accelerationRuntime.accLpfCutHz;
+            pt2FilterInit(&thrustFilter, thrustFilterHz > 0 ? pt2FilterGain(thrustFilterHz, HZ_TO_INTERVAL(acc.sampleRateHz)) : 1.0f);
+        }
         bool rpm;
-        const float cz = acc.accADC.v[Z] * acc.dev.acc_1G_rec - (frogThrustK > 0.0f ? frogThrustK * frogThrustProxy(&rpm) : 0.0f);
+        const float proxy = frogThrustProxy(&rpm);
+        frogThrustProxyFilt = thrustFilterHz > 0 ? pt2FilterApply(&thrustFilter, proxy) : proxy;
+        const float cz = acc.accADC.v[Z] * acc.dev.acc_1G_rec - frogThrustK * frogThrustProxyFilt;
         const float c = sqrtf(cx * cx + cy * cy + cz * cz);
         if (c > frogContactPeakG) {
             frogContactPeakG = c;
