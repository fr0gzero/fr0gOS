 static void osdElementGForce(osdElementParms_t *element)
 {
-    osdPrintFloat(element->buff, SYM_NONE, osdGForce, "", 1, true, 'G');
+    static float held = 0.0f;
+    static timeMs_t heldAt = 0;
+    const timeMs_t now = millis();
+    if (osdGForce >= held || now - heldAt > 500) {
+        held = osdGForce;
+        heldAt = now;
+    }
+    const int g10 = lrintf(held * 10.0f);
+    bool record = false;
+#ifdef USE_PERSISTENT_STATS
+    record = ARMING_FLAG(ARMED) && statsConfig()->frog_best_g10 > 0 && g10 > statsConfig()->frog_best_g10;
+#endif
+    char *b = element->buff;
+    if (record) {
+        *b++ = '!';
+    }
+    if (g10 >= 100) {
+        tfp_sprintf(b, "%dG", g10 / 10);
+    } else {
+        tfp_sprintf(b, "%d.%dG", g10 / 10, g10 % 10);
+    }
+
+    const bool hd = frogHdFont(element->osdDisplayPort);
+    const bool violent = g10 >= 35;
+    const int len = strlen(element->buff);
+    static const uint8_t chase[3] = { DISPLAYPORT_SEVERITY_NORMAL, DISPLAYPORT_SEVERITY_WARNING, DISPLAYPORT_SEVERITY_CRITICAL };
+    // glitch: at 3.5G+ one character scrambles now and then
+    const uint32_t r = frogRand();
+    const int glitchAt = (violent && (r & 3) == 0) ? (int)((r >> 2) % len) : -1;
+    if (!hd) {
+        return;                     // analog: plain number, nothing scrambles live flight data
+    }
+    for (int i = 0; i < len; i++) {
+        uint8_t sev;
+        if (record) {
+            sev = chase[(i + now / 70) % 3];
+        } else if (violent) {
+            sev = ((i + now / 80) % 2) ? DISPLAYPORT_SEVERITY_CRITICAL : DISPLAYPORT_SEVERITY_WARNING;
+        } else if (g10 >= 25) {
+            sev = DISPLAYPORT_SEVERITY_CRITICAL;
+        } else if (g10 >= 15) {
+            sev = DISPLAYPORT_SEVERITY_WARNING;
+        } else {
+            sev = DISPLAYPORT_SEVERITY_NORMAL;
+        }
+        element->buff[i] = (i == glitchAt) ? (char)frogColourNoiseChar(sev == DISPLAYPORT_SEVERITY_NORMAL ? DISPLAYPORT_SEVERITY_WARNING : sev)
+                                            : (char)frogColourChar((uint8_t)element->buff[i], sev);
+    }
