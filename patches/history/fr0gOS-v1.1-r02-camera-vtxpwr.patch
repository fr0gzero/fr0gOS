+// VTX transmit power in mW, e.g. 200MW (labels that aren't numbers, like PIT, shown as is)
+static void osdElementFrogVtxPower(osdElementParms_t *element)
+{
+#ifdef USE_VTX_COMMON
+    const vtxDevice_t *vtx = vtxCommonDevice();
+    if (vtx && vtxCommonDeviceIsReady(vtx)) {
+        uint8_t level = 0;
+        vtxCommonGetPowerIndex(vtx, &level);
+        const char *label = vtxCommonLookupPowerName(vtx, level);
+        if (label && label[0] >= '0' && label[0] <= '9') {
+            tfp_sprintf(element->buff, "%sMW", label);
+        } else {
+            tfp_sprintf(element->buff, "%s", label ? label : "--");
+        }
+        return;
+    }
+#endif
+    strcpy(element->buff, "--");
+}
