+// fr0gOS: every warning fits the 5-character side bar
+static void frogShortenWarning(char *buff)
+{
+    static const struct { const char *from; const char *to; } map[] = {
+        { "LOW BATTERY",  "LOWV"  },
+        { "LAND NOW",     "LAND!" },
+        { "FAIL SAFE",    "FSAFE" },
+        { "LINK QUALITY", "LQ!"   },
+        { "RSSI LOW",     "RSSI!" },
+        { "RSSI DBM",     "DBM!"  },
+        { "RSNR LOW",     "SNR!"  },
+        { "CPU OVERLOAD", "CPU!"  },
+        { "CRASHFLIP SW", "FLPSW" },
+        { CRASHFLIP_WARNING, "TURTL" },
+        { "HEADFREE",     "HFREE" },
+        { "OVER CAP",     "OVCAP" },
+        { "BATTERY CONT", "BCONT" },
+        { "BATT < FULL",  "!FULL" },
+        { "BEACON ON",    "BEACN" },
+        { "RESCUE FAIL",  "RESC!" },
+        { "RESCUE N/A",   "NORSC" },
+    };
+    const char *s = buff;
+    while (*s == ' ') {
+        s++;
+    }
+    for (unsigned i = 0; i < ARRAYLEN(map); i++) {
+        if (strcmp(s, map[i].from) == 0) {
+            strcpy(buff, map[i].to);
+            return;
+        }
+    }
+    if (s != buff) {
+        memmove(buff, s, strlen(s) + 1);
+    }
+    if (strlen(buff) > 5) {
+        buff[5] = '\0';   // arming flags etc: THROT, RXLOS, NOGYR, ARMSW...
+    }
+}
