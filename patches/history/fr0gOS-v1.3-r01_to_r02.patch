+uint8_t frogFlipNoiseChar(bool hd)
+{
+    // crash-flip noise: red blocks and red/amber characters on HD, plain noise on analog
+    if (!hd) {
+        return frogNoiseChar(false);
+    }
+    const uint32_t r = frogRand();
+    if (r & 1) {
+        return FROG_GLYPH_RSCRAMBLE1 + (r >> 1) % 3;
+    }
+    return frogColourNoiseChar((r & 2) ? DISPLAYPORT_SEVERITY_WARNING : DISPLAYPORT_SEVERITY_CRITICAL);
+}
 static uint8_t frogRedNoiseChar(bool hd)
