+        for (int i = 0; element->buff[i]; i++) {
+            const uint8_t sev = ((i + now / 90) % 2) ? DISPLAYPORT_SEVERITY_CRITICAL : DISPLAYPORT_SEVERITY_WARNING;
+            if (i == glitchAt) {
+                element->buff[i] = hd ? (char)frogColourNoiseChar(sev) : (char)frogNoiseChar(false);
+            } else if (hd) {
+                element->buff[i] = (char)frogColourChar((uint8_t)element->buff[i], sev);
+            }
+        }
+        element->attr = DISPLAYPORT_SEVERITY_NORMAL;
+    }
