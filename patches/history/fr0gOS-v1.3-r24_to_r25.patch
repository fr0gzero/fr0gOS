+// combo broken by a crash: the count shakes red, crumbles into debris that falls onto the line below,
+// then BREAK flashes there
+static bool frogComboCrashLine(char *b, bool hd, timeMs_t now, bool word)
+{
+    if (!frogComboCrashAt) {
+        return false;
+    }
+    const uint32_t t = now - frogComboCrashAt;
+    if (t >= FROG_COMBO_CRASH_MS) {
+        frogComboCrashAt = 0;
+        return false;
+    }
+    const uint8_t red = DISPLAYPORT_SEVERITY_CRITICAL;
+    char num[8];
+    tfp_sprintf(num, frogComboFinal >= 10 ? "X%d!" : "X%d", frogComboFinal);
+    const int len = strlen(num);
+    b[0] = '\0';
+    if (!word) {
+        if (t < 350) {                                   // shake: jitter a cell left / right
+            const bool shift = (t / 60) % 2;
+            tfp_sprintf(b, "%s%s", shift ? " " : "", num);
+            for (int i = 0; b[i]; i++) {
+                if (b[i] != ' ' && hd) {
+                    b[i] = (char)frogColourChar((uint8_t)b[i], red);
+                }
+            }
+        } else if (t < 800) {                            // crumble, left to right
+            strcpy(b, num);
+            for (int i = 0; i < len; i++) {
+                const uint32_t at = 350 + 70 * i;
+                b[i] = t < at ? (hd ? (char)frogColourChar((uint8_t)b[i], red) : b[i])
+                     : t < at + 110 ? (hd ? (char)frogColourNoiseChar(red) : (char)frogNoiseChar(false)) : ' ';
+            }
+        }
+        return true;
+    }
+    if (t >= 420 && t < 900) {                           // the debris lands on the line below and fizzles
+        for (int i = 0; i < len; i++) {
+            const uint32_t at = 420 + 70 * i;
+            b[i] = (t >= at && t < at + 240) ? (hd ? (char)frogColourNoiseChar(red) : (char)frogNoiseChar(false)) : ' ';
+        }
+        b[len] = '\0';
+    } else if (t >= 900) {
+        strcpy(b, "BREAK");
+        frogSongDecode(b, t - 900, FROG_COMBO_CRASH_MS - 900, red, hd);
+    }
+    return true;
+}
+
+// time left in the chain, as 4 cells (1 s each, half cells as '-'), red in the last second
+static void frogComboMeter(char *b, uint8_t sev, bool hd, timeMs_t now)
+{
+    const int32_t left = (int32_t)FROG_COMBO_WINDOW_MS - (int32_t)(now - frogComboLastAt);
+    int len = strlen(b);
+    b[len++] = ' ';
+    const uint8_t s = left < 1000 ? DISPLAYPORT_SEVERITY_CRITICAL : sev;
+    for (int i = 0; i < 4 && len < 9; i++) {
+        const char c = left >= (i + 1) * 1000 ? '=' : left >= i * 1000 + 500 ? '-' : ' ';
+        b[len++] = (hd && c != ' ') ? (char)frogColourChar((uint8_t)c, s) : c;
+    }
+    while (len > 0 && b[len - 1] == ' ') {
+        len--;
+    }
+    b[len] = '\0';
+}
