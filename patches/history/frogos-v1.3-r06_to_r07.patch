diff --git a/src/main/osd/osd_elements.c b/src/main/osd/osd_elements.c
index dc6ef17..aac3757 100644
--- a/src/main/osd/osd_elements.c
+++ b/src/main/osd/osd_elements.c
@@ -1559,6 +1559,86 @@ typedef struct {
 static frogFeedEvent_t frogFeed[2];
 static timeMs_t frogFeedAt = 0;
 
+// ---- the frog hops around the black bars ----
+// On events (arm, crash flip, mode / air changes, tricks, warnings...) the frog sometimes jumps to a
+// random free spot: never sooner than 12 s after the last hop, 50/50 between 12 and 20 s, certain after
+// 20 s. Free spots come from the live layout (rows on that side with no element), 3 columns per side.
+static int8_t frogX = 0, frogY = 0, frogFromX = 0, frogFromY = 0;
+static timeMs_t frogHopAt = 0, frogLastHop = 0;
+static uint8_t frogCols = 50, frogRowsN = 18;
+
+static bool frogRowBusy(bool right, int row)
+{
+    for (int i = 0; i < OSD_ITEM_COUNT; i++) {
+        const uint16_t pos = osdElementConfig()->item_pos[i];
+        if (!VISIBLE(pos) || i == OSD_FROG_GLITCH) {
+            continue;
+        }
+        const int x = OSD_X(pos), y = OSD_Y(pos);
+        const bool isRight = x >= frogCols - FROG_EDGE_ZONE;
+        if (x >= FROG_EDGE_ZONE && !isRight) {
+            continue;
+        }
+        if (isRight != right) {
+            continue;
+        }
+        if (i == OSD_FROG_TAG) {
+            if (row == y + 1 || row == y + 2) {           // the two feed lines (the frog row itself is free)
+                return true;
+            }
+            continue;
+        }
+        if (row == y || ((i == OSD_THROTTLE_POS || i == OSD_ESC_RPM) && row == y + 1)) {
+            return true;                                  // labelled readouts use two rows
+        }
+    }
+    return false;
+}
+
+static void frogHop(timeMs_t now)
+{
+    int8_t cx[64], cy[64];
+    int n = 0;
+    static const uint8_t inset[3] = { 0, 2, 4 };
+    for (int side = 0; side < 2; side++) {
+        for (int y = 0; y < frogRowsN && n < 61; y++) {
+            if (frogRowBusy(side, y)) {
+                continue;
+            }
+            for (int k = 0; k < 3; k++) {
+                cx[n] = side ? frogCols - 1 - inset[k] : inset[k];
+                cy[n] = y;
+                n++;
+            }
+        }
+    }
+    if (n < 2) {
+        return;
+    }
+    int pick = frogRand() % n;
+    if (cx[pick] == frogX && cy[pick] == frogY) {
+        pick = (pick + 1 + frogRand() % (n - 1)) % n;
+    }
+    frogFromX = frogX;
+    frogFromY = frogY;
+    frogX = cx[pick];
+    frogY = cy[pick];
+    frogHopAt = now ? now : 1;
+    frogLastHop = frogHopAt;
+}
+
+static void frogMaybeHop(timeMs_t now)
+{
+    const uint32_t since = frogLastHop ? now - frogLastHop : 20000;
+    if (since < 12000) {
+        return;
+    }
+    if (since < 20000 && (frogRand() & 1)) {
+        return;
+    }
+    frogHop(now);
+}
