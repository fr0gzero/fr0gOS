+static void osdElementFrogAirMode(osdElementParms_t *element)
+{
+    strcpy(element->buff, isAirmodeEnabled() ? "AIRON" : "AIROF");
+}
+
+#ifdef USE_RX_LINK_QUALITY_INFO
+// ELRS 4.x reports its packet rate enum in CRSF link stats rf_Mode
+// (ExpressLRS src/include/common.h, expresslrs_RFrates_e, 2.4 GHz block).
+// L = LoRa, D = FLRC DVDA, F = FLRC, K = FSK, + = full-res 8ch.
+const char *frogRfRateLabel(uint8_t rfMode)
+{
+    switch (rfMode) {
+    case 20: return "L25";
+    case 21: return "L50";
+    case 22: return "L100";
+    case 23: return "L100+";
+    case 24: return "L150";
+    case 25: return "L200";
+    case 26: return "L200+";
+    case 27: return "L250";
+    case 28: return "L333+";
+    case 29: return "L500";
+    case 30: return "D250";
+    case 31: return "D500";
+    case 32: return "F500";
+    case 33: return "F1000";
+    case 34: return "KD250";
+    case 35: return "KD500";
+    case 36: return "K1000";
+    default: return NULL;
+    }
+}
+#endif
+
+static void osdElementFrogRfRate(osdElementParms_t *element)
+{
+#ifdef USE_RX_LINK_QUALITY_INFO
+    if (!isRxReceivingSignal()) {
+        strcpy(element->buff, "-----");
+        return;
+    }
+    if (linkQualitySource == LQ_SOURCE_RX_PROTOCOL_CRSF) {
+        const uint8_t rfMode = rxGetRfMode();
+        const char *label = frogRfRateLabel(rfMode);
+        if (label) {
+            strcpy(element->buff, label);
+        } else {
+            tfp_sprintf(element->buff, "RF%u", rfMode);
+        }
+        return;
+    }
+#endif
+    strcpy(element->buff, "--");
+}
+static void osdElementFrogBattPct(osdElementParms_t *element)
+{
+    tfp_sprintf(element->buff, "%d%%", calculateBatteryPercentageRemaining());
+}
