+// Mode-change reaction: when a switch-driven readout changes (flight mode, air mode, packet rate,
+// VTX power) the new text decodes in from colourful noise, then green/amber/red chase along it
+// before it settles. Only for readouts that change when you flip a switch, never live numbers.
+#define FROG_MODEFX_MS 800
+typedef struct {
+    char last[OSD_ELEMENT_BUFFER_LENGTH];
+    timeMs_t changedAt;
+    bool seen;
+} frogModeFx_t;
+
+static void frogModeFx(frogModeFx_t *st, osdElementParms_t *element)
+{
+    const timeMs_t now = millis();
+    if (strcmp(st->last, element->buff) != 0) {
+        if (st->seen && element->buff[0]) {            // not on first draw, and nothing to animate when it goes blank
+            st->changedAt = now ? now : 1;
+        }
+        strncpy(st->last, element->buff, sizeof(st->last) - 1);
+        st->last[sizeof(st->last) - 1] = '\0';
+        st->seen = true;
+    }
+    if (st->changedAt == 0) {
+        return;
+    }
+    const uint32_t t = now - st->changedAt;
+    if (t >= FROG_MODEFX_MS) {
+        st->changedAt = 0;
+        return;
+    }
+    const bool hd = frogHdFont(element->osdDisplayPort);
+    static const uint8_t chase[3] = { DISPLAYPORT_SEVERITY_NORMAL, DISPLAYPORT_SEVERITY_WARNING, DISPLAYPORT_SEVERITY_CRITICAL };
+    for (unsigned i = 0; element->buff[i]; i++) {
+        const uint8_t c = (uint8_t)element->buff[i];
+        if (t < 60 * i + 180) {
+            // still decoding: coloured noise on HD, plain noise on analog
+            element->buff[i] = hd ? (char)frogColourNoiseChar(chase[frogRand() % 3]) : (char)frogNoiseChar(false);
+        } else if (hd) {
+            element->buff[i] = (char)frogColourChar(c, chase[(i + t / 70) % 3]);
+        }
+    }
+}
+
