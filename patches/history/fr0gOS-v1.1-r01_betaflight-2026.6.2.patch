+// ---------------- fr0gOS arming glitch ----------------
+#define FROG_ARMFX_SWEEP_MS 360
+#define FROG_ARMFX_TOTAL_US (600 * 1000)
+static bool frogArmFxActive = false;
+static timeUs_t frogArmFxStartUs = 0;
+
+static void frogDrawArmFx(timeUs_t now)
+{
+    const uint32_t ms = (now - frogArmFxStartUs) / 1000;
+    const bool hd = frogHdFont(osdDisplayPort);
+    const int rows = osdDisplayPort->rows;
+    const int cols = MIN(osdDisplayPort->cols, 63);
+    char line[64];
+
+    displayClearScreen(osdDisplayPort, DISPLAY_CLEAR_NONE);
+    if (ms < FROG_ARMFX_SWEEP_MS) {
+        // a two-row band of noise sweeps top to bottom, plus a few strays
+        const int band = (int)((ms * rows) / FROG_ARMFX_SWEEP_MS);
+        for (int r = band - 1; r <= band; r++) {
+            if (r < 0 || r >= rows) {
+                continue;
+            }
+            for (int c = 0; c < cols; c++) {
+                line[c] = (frogRand() % 4 == 0) ? ' ' : (char)frogNoiseChar(hd);
+            }
+            line[cols] = '\0';
+            // MSP displayport caps one write at 30 chars, so send the row in chunks
+            for (int c = 0; c < cols; c += 25) {
+                char chunk[26];
+                const int n = MIN(25, cols - c);
+                memcpy(chunk, &line[c], n);
+                chunk[n] = '\0';
+                displayWrite(osdDisplayPort, c, r, DISPLAYPORT_SEVERITY_NORMAL, chunk);
+            }
+        }
+        for (int i = 0; i < 6; i++) {
+            const char g[2] = { (char)frogNoiseChar(hd), '\0' };
+            displayWrite(osdDisplayPort, frogRand() % cols, frogRand() % rows, DISPLAYPORT_SEVERITY_NORMAL, g);
+        }
+    }
+    // [ARM] decodes in the middle
+    static const char text[] = "[ARM]";
+    char out[sizeof(text)];
+    for (unsigned i = 0; i < sizeof(text) - 1; i++) {
+        out[i] = (ms >= FROG_ARMFX_SWEEP_MS / 2 + i * 50) ? text[i] : (char)frogNoiseChar(hd);
+    }
+    out[sizeof(text) - 1] = '\0';
+    displayWrite(osdDisplayPort, osdDisplayPort->cols / 2 - 2, rows / 2, DISPLAYPORT_SEVERITY_NORMAL, out);
+}
