+// fr0gOS: a new warning "decodes" in - noise characters lock into the real text
+// one by one, then it sits in its severity colour (amber / red on the HD font)
+static void frogDecodeWarning(osdElementParms_t *element)
+{
+    static char target[OSD_ELEMENT_BUFFER_LENGTH];
+    static timeMs_t startMs;
+    const timeMs_t now = millis();
+    const uint8_t severity = element->buff[0] ? element->attr : DISPLAYPORT_SEVERITY_NORMAL;
+    extern uint8_t frogWarnSeverity;
+    frogWarnSeverity = severity;
+
+    if (element->buff[0] == '\0') {
+        target[0] = '\0';
+        return;
+    }
+    if (strcmp(element->buff, target) != 0) {
+        strncpy(target, element->buff, sizeof(target) - 1);
+        target[sizeof(target) - 1] = '\0';
+        startMs = now;
+    }
+    const bool hd = frogHdFont(element->osdDisplayPort);
+    const uint32_t t = now - startMs;
+    const size_t len = strlen(target);
+    for (size_t i = 0; i < len; i++) {
+        if (t >= 120 + i * 90) {
+            element->buff[i] = hd ? (char)frogColourChar((uint8_t)target[i], severity) : target[i];
+        } else {
+            element->buff[i] = (char)frogNoiseChar(hd);
+        }
+    }
+    element->buff[len] = '\0';
+    if (hd) {
+        element->attr = DISPLAYPORT_SEVERITY_NORMAL;   // already coloured per character
+    }
+}
+
+// fr0gOS: every warning fits the 5-character side bar
+static void frogShortenWarning(char *buff)
+{
+    static const struct { const char *from; const char *to; } map[] = {
+        { "LOW BATTERY",  "LOWV"  },
+        { "LAND NOW",     "LAND!" },
+        { "FAIL SAFE",    "FSAFE" },
+        { "LINK QUALITY", "LQ!"   },
+        { "RSSI LOW",     "RSSI!" },
+        { "RSSI DBM",     "DBM!"  },
+        { "RSNR LOW",     "SNR!"  },
+        { "CPU OVERLOAD", "CPU!"  },
+        { "CRASHFLIP SW", "FLPSW" },
+        { CRASHFLIP_WARNING, "TURTL" },
+        { "HEADFREE",     "HFREE" },
+        { "OVER CAP",     "OVCAP" },
+        { "BATTERY CONT", "BCONT" },
+        { "BATT < FULL",  "!FULL" },
+        { "BEACON ON",    "BEACN" },
+        { "RESCUE FAIL",  "RESC!" },
+        { "RESCUE N/A",   "NORSC" },
+    };
+    const char *s = buff;
+    while (*s == ' ') {
+        s++;
+    }
+    for (unsigned i = 0; i < ARRAYLEN(map); i++) {
+        if (strcmp(s, map[i].from) == 0) {
+            strcpy(buff, map[i].to);
+            return;
+        }
+    }
+    if (s != buff) {
+        memmove(buff, s, strlen(s) + 1);
+    }
+    if (strlen(buff) > 5) {
+        buff[5] = '\0';   // arming flags etc: THROT, RXLOS, NOGYR, ARMSW...
+    }
+}
