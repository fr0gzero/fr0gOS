+// ---------------- fr0gOS boot screen ----------------
+#define FR0GOS_VERSION   "V1.1 R01"
+#define FROG_BOOT_WIDTH  22
+#define FROG_BOOT_LINES  7
+
+static bool frogBootActive = false;
+static timeUs_t frogBootNextDrawUs = 0;
+static timeUs_t frogBootStartUs = 0;
+static int frogBootLineNo = 0;
+#define FROG_BOOT_STEP_MS 220   // each check "runs" this long before it reports
+
+static void frogUpper(char *s)
+{
+    for (; *s; s++) {
+        *s = toupper((unsigned char)*s);
+    }
+}
+
+// "LBL  detail ........ STAT" padded to FROG_BOOT_WIDTH
+static void frogBootLine(int x, int y, const char *label, const char *detail, const char *status)
+{
+    // BIOS-style reveal: line N appears after N steps, spins for one step, then reports
+    const int idx = ++frogBootLineNo;
+    const uint32_t ms = (micros() - frogBootStartUs) / 1000;
+    if (ms < (uint32_t)idx * FROG_BOOT_STEP_MS) {
+        return;
+    }
+    char spin[2] = { "|/-\\"[(ms / 80) % 4], '\0' };
+    const bool running = ms < (uint32_t)(idx + 1) * FROG_BOOT_STEP_MS;
+    if (running) {
+        status = spin;
+    }
+    char line[FROG_BOOT_WIDTH + 1];
+    memset(line, '.', FROG_BOOT_WIDTH);
+    line[FROG_BOOT_WIDTH] = '\0';
+
+    // label padded to 4, then detail (tfp_sprintf has no %-4s)
+    char head[FROG_BOOT_WIDTH + 1];
+    memset(head, ' ', sizeof(head));
+    const size_t labelLen = MIN(strlen(label), (size_t)4);
+    memcpy(head, label, labelLen);
+    const size_t detailLen = MIN(strlen(detail), (size_t)(FROG_BOOT_WIDTH - 6));
+    memcpy(&head[5], detail, detailLen);
+    head[5 + detailLen + (detailLen ? 1 : 0)] = '\0';
+    frogUpper(head);
+    size_t headLen = strlen(head);
+    const size_t statLen = strlen(status);
+    if (headLen > FROG_BOOT_WIDTH - statLen - 1) {
+        headLen = FROG_BOOT_WIDTH - statLen - 1;
+    }
+    memcpy(line, head, headLen);
+    line[FROG_BOOT_WIDTH - statLen - 1] = ' ';
+    memcpy(&line[FROG_BOOT_WIDTH - statLen], status, statLen);
+    if (frogHdFont(osdDisplayPort) && !running) {
+        const uint8_t sev = (strcmp(status, "OK") == 0 || strcmp(status, "--") == 0) ? DISPLAYPORT_SEVERITY_NORMAL
+                          : strcmp(status, "FAIL") == 0 ? DISPLAYPORT_SEVERITY_CRITICAL
+                          : DISPLAYPORT_SEVERITY_WARNING;
+        frogColourise(&line[FROG_BOOT_WIDTH - statLen], sev);
+    }
+    displayWrite(osdDisplayPort, x, y, DISPLAYPORT_SEVERITY_NORMAL, line);
+}
+
+static void osdFrogDrawBootStatus(void)
+{
+    frogBootLineNo = 0;
+    const int rows = osdDisplayPort->rows;
+    const int midRow = rows / 2;
+    const int x = (osdDisplayPort->cols / 2) - (FROG_BOOT_WIDTH / 2);
+    int y = midRow - 5 + frogLogoRows() + 1;
+    if (y + FROG_BOOT_LINES > rows) {
+        y = rows - FROG_BOOT_LINES;
+    }
+    char detail[16];
+
+    // header: FR0GOS V1.0 R01 ..... MK4-1
+    char head[FROG_BOOT_WIDTH + 1];
+    char craft[MAX_NAME_LENGTH + 1];
+    strncpy(craft, pilotConfig()->craftName, MAX_NAME_LENGTH);
+    craft[MAX_NAME_LENGTH] = '\0';
+    frogUpper(craft);
+    memset(head, ' ', FROG_BOOT_WIDTH);
+    head[FROG_BOOT_WIDTH] = '\0';
+    memcpy(head, "FR0GOS " FR0GOS_VERSION, strlen("FR0GOS " FR0GOS_VERSION));
+    const size_t craftLen = MIN(strlen(craft), (size_t)6);
+    memcpy(&head[FROG_BOOT_WIDTH - craftLen], craft, craftLen);
+    displayWrite(osdDisplayPort, x, y++, DISPLAYPORT_SEVERITY_NORMAL, head);
+
+    // CPU
+    const char *mcu = targetName;
+    if (strncmp(mcu, "STM32", 5) == 0) {
+        mcu += 5;
+    }
+    char mcu4[5];
+    strncpy(mcu4, mcu, 4);
+    mcu4[4] = '\0';
+#ifdef USE_ADC_INTERNAL
+    tfp_sprintf(detail, "%s C%d", mcu4, getCoreTemperatureCelsius());
+#else
+    tfp_sprintf(detail, "%s", mcu4);
+#endif
+    frogBootLine(x, y++, "CPU", detail, "OK");
+
+    // GYRO
+    frogBootLine(x, y++, "GYRO", "", sensors(SENSOR_GYRO) ? "OK" : "FAIL");
+
+    // RX: WAIT (not FAIL) until the radio links
+    if (isRxReceivingSignal()) {
+        const char *rate = NULL;
+#ifdef USE_RX_LINK_QUALITY_INFO
+        if (linkQualitySource == LQ_SOURCE_RX_PROTOCOL_CRSF) {
+            rate = frogRfRateLabel(rxGetRfMode());
+        }
+#endif
+        frogBootLine(x, y++, "RX", rate ? rate : "LINK", "OK");
+    } else {
+        frogBootLine(x, y++, "RX", "", "WAIT");
+    }
+
+    // VTX
+#ifdef USE_VTX_COMMON
+    const vtxDevice_t *vtx = vtxCommonDevice();
+    if (!vtx) {
+        frogBootLine(x, y++, "VTX", "", "NONE");
+    } else if (!vtxCommonDeviceIsReady(vtx)) {
+        frogBootLine(x, y++, "VTX", "", "WAIT");
+    } else {
+        const vtxSettingsConfig_t *vs = vtxSettingsConfig();
+        const char *pwr = vtxCommonLookupPowerName(vtx, vs->power);
+        tfp_sprintf(detail, "%c%d %s", vtxCommonLookupBandLetter(vtx, vs->band), vs->channel, pwr ? pwr : "");
+        frogBootLine(x, y++, "VTX", detail, "OK");
+    }
+#else
+    frogBootLine(x, y++, "VTX", "", "NONE");
+#endif
+
+    // ESC: real bidirectional DShot telemetry check
+    const uint8_t motorCount = getMotorCount();
+#ifdef USE_DSHOT_TELEMETRY
+    if (motorConfig()->dev.useDshotTelemetry && motorCount) {
+        uint8_t alive = 0;
+        for (uint8_t i = 0; i < motorCount; i++) {
+            if (isDshotMotorTelemetryActive(i)) {
+                alive++;
+            }
+        }
+        tfp_sprintf(detail, "%d/%d", alive, motorCount);
+        frogBootLine(x, y++, "ESC", detail, alive == motorCount ? "OK" : "WAIT");
+    } else
+#endif
+    {
+        tfp_sprintf(detail, "%d MTR", motorCount);
+        frogBootLine(x, y++, "ESC", detail, "--");
+    }
+
+    // BATT
+    const uint16_t cv = getBatteryVoltage();
+    tfp_sprintf(detail, "%d.%02dV", cv / 100, cv % 100);
+    switch (getBatteryState()) {
+    case BATTERY_OK:       frogBootLine(x, y++, "BATT", detail, "OK");   break;
+    case BATTERY_WARNING:  frogBootLine(x, y++, "BATT", detail, "LOW");  break;
+    case BATTERY_CRITICAL: frogBootLine(x, y++, "BATT", detail, "FAIL"); break;
+    default:               frogBootLine(x, y++, "BATT", "", "NONE");     break;
+    }
+}
+// -------------- end fr0gOS boot screen --------------
+
