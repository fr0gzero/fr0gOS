+// ---------------- fr0gOS hacker font helpers ----------------
+bool frogHdFont(const displayPort_t *displayPort)
+{
+    return osdConfig()->frog_hd_font && displayPort && displayPort->deviceType == DISPLAYPORT_DEVICE_TYPE_MSP;
+}
+
+uint32_t frogRand(void)
+{
+    static uint32_t state = 0;
+    if (state == 0) {
+        state = micros() | 1;
+    }
+    state ^= state << 13;
+    state ^= state >> 17;
+    state ^= state << 5;
+    return state;
+}
+
+uint8_t frogColourChar(uint8_t c, uint8_t severity)
+{
+    if (c < 0x20 || c > 0x5F) {
+        return c;
+    }
+    uint8_t mapped = 0;
+    if (severity == DISPLAYPORT_SEVERITY_WARNING) {
+        mapped = frogAmberMap[c - 0x20];
+    } else if (severity == DISPLAYPORT_SEVERITY_CRITICAL) {
+        mapped = frogRedMap[c - 0x20];
+    }
+    return mapped ? mapped : c;
+}
+
+void frogColourise(char *s, uint8_t severity)
+{
+    for (; *s; s++) {
+        *s = (char)frogColourChar((uint8_t)*s, severity);
+    }
+}
+
+// one character of decode noise: shade blocks and green letters on HD, ASCII on analog
+#define FROG_HIGH_G 2.5f   // frog squashes above this many G
+static uint8_t frogColourNoiseChar(uint8_t severity);
+// fr0gOS battery stages (per cell, live sag voltage so a hard punch flicks it down a stage)
+typedef enum { FROG_BATT_FULL = 0, FROG_BATT_GOOD, FROG_BATT_MID, FROG_BATT_LOW, FROG_BATT_LAND, FROG_BATT_DEAD } frogBattStage_e;
+static frogBattStage_e frogBattStage(void);
+static uint8_t frogBattSeverity(frogBattStage_e st, int i, timeMs_t now);
+
+uint8_t frogNoiseChar(bool hd)
+{
+    static const char ascii[] = "#%&*+=?@$/\\<>XZ0123456789";
+    const uint32_t r = frogRand();
+    if (hd && (r & 1)) {
+        return FROG_GLYPH_SCRAMBLE1 + (r >> 1) % 3;
+    }
+    return ascii[(r >> 2) % (sizeof(ascii) - 1)];
+}
+
+// fr0gOS edge justification, anchored to the element's own column so it works
+// whatever canvas width the FC believes it has:
+//  - element in the left 8 columns: padding stripped, text starts at its column
+//  - element in the right 8 columns: padding stripped, text ENDS at its column
+#define FROG_EDGE_ZONE 8
+bool frogIdleShimmer = false;   // analog screensaver: set by osd.c after 5 s idle
+
+static void osdFrogWriteJustified(osdElementParms_t *element, uint8_t x, uint8_t y, uint8_t attr, const char *s)
+{
+    char coloured[OSD_ELEMENT_BUFFER_LENGTH];
+    char shimmer[OSD_ELEMENT_BUFFER_LENGTH];
+    if (frogIdleShimmer && !frogHdFont(element->osdDisplayPort) && (frogRand() % 10) == 0) {
+        // analog screensaver: a character of existing text flips for one frame, nothing new appears
+        strncpy(shimmer, s, sizeof(shimmer) - 1);
+        shimmer[sizeof(shimmer) - 1] = '\0';
+        const int len = strlen(shimmer);
+        if (len > 0) {
+            const int i = frogRand() % len;
+            if (shimmer[i] != ' ') {
+                shimmer[i] = (char)frogNoiseChar(false);
+            }
+        }
+        s = shimmer;
+    }
+    const uint8_t severity = attr & ~DISPLAYPORT_BLINK;
+    if (frogHdFont(element->osdDisplayPort) &&
+        (severity == DISPLAYPORT_SEVERITY_WARNING || severity == DISPLAYPORT_SEVERITY_CRITICAL)) {
+        strncpy(coloured, s, sizeof(coloured) - 1);
+        coloured[sizeof(coloured) - 1] = '\0';
+        frogColourise(coloured, severity);
+        s = coloured;
+        attr = (attr & DISPLAYPORT_BLINK) | DISPLAYPORT_SEVERITY_NORMAL;
+    }
+    const uint8_t cols = element->osdDisplayPort->cols;
+    const bool leftZone = x < FROG_EDGE_ZONE;
+    const bool rightZone = cols > FROG_EDGE_ZONE * 2 && x >= cols - FROG_EDGE_ZONE;
+    if (leftZone || rightZone) {
+        while (*s == ' ') {
+            s++;
+        }
+        if (rightZone) {
+            char tmp[OSD_ELEMENT_BUFFER_LENGTH];
+            int len = strlen(s);
+            while (len > 0 && s[len - 1] == ' ') {
+                len--;
+            }
+            if (len >= (int)sizeof(tmp)) {
+                len = sizeof(tmp) - 1;
+            }
+            memcpy(tmp, s, len);
+            tmp[len] = '\0';
+            const int nx = (int)x + 1 - len;
+            osdDisplayWrite(element, nx < 0 ? 0 : nx, y, attr, tmp);
+            return;
+        }
+    }
+    osdDisplayWrite(element, x, y, attr, s);
+}
