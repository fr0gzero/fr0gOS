+            const char *ghost = frogFxLast[item];
+            size_t i = 0;
+            for (; ghost[i]; i++) {
+                element->buff[i] = (ghost[i] == ' ' || t >= FROG_FX_OUT_MS + FROG_FX_STEP_MS * i) ? ' ' : (char)frogNoiseChar(hd);
+            }
+            element->buff[i] = '\0';
+            element->drawElement = true;
+            element->attr = DISPLAYPORT_SEVERITY_NORMAL;
+        }
+    }
+}
