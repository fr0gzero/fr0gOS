+// VTX transmit power in mW, e.g. 200MW (labels that aren't numbers, like PIT, shown as is)
+static void osdElementFrogVtxPower(osdElementParms_t *element)
+{
+#ifdef USE_VTX_COMMON
+    const vtxDevice_t *vtx = vtxCommonDevice();
+    if (vtx && vtxCommonDeviceIsReady(vtx)) {
+        uint8_t level = 0;
+        vtxCommonGetPowerIndex(vtx, &level);
+        const char *label = vtxCommonLookupPowerName(vtx, level);
+        char lab[8];
+        strncpy(lab, label ? label : "--", sizeof(lab) - 1);
+        lab[sizeof(lab) - 1] = '\0';
+        for (int n = strlen(lab); n > 0 && lab[n - 1] == ' '; n--) {
+            lab[n - 1] = '\0';                       // vtxtable labels are space-padded ("25 ")
+        }
+        if (lab[0] >= '0' && lab[0] <= '9') {
+            tfp_sprintf(element->buff, "%sMW", lab);
+        } else {
+            tfp_sprintf(element->buff, "%s", lab);
+        }
+        static frogModeFx_t fx = { .feed = true };
+        frogModeFx(&fx, element);
+        return;
+    }
+#endif
+    strcpy(element->buff, "--");
+}
+// Red noise for the power side: a red block on HD, plain noise on analog
+uint8_t frogFlipNoiseChar(bool hd)
+{
+    // crash-flip noise: red blocks and red/amber characters on HD, plain noise on analog
+    if (!hd) {
+        return frogNoiseChar(false);
+    }
+    const uint32_t r = frogRand();
+    if (r & 1) {
+        return FROG_GLYPH_RSCRAMBLE1 + (r >> 1) % 3;
+    }
+    return frogColourNoiseChar((r & 2) ? DISPLAYPORT_SEVERITY_WARNING : DISPLAYPORT_SEVERITY_CRITICAL);
+}
+// ---- battery stages ----
+//   FULL  >= 4.00 V   green, bar 4
+//   GOOD  >= 3.80 V   green, bar 3
+//   MID   >= 3.65 V   green, bar 2
+//   LOW   >= 3.50 V   amber, bar 1, slow breathe            (animates)
+//   LAND  >= 3.35 V   red/amber pulse, bar 0 blinking        (animates)
+//   DEAD  <  3.35 V   red flicker, % scrambles, bar strobes  (animates hard)
+// Volts per cell from Betaflight's fast sag filter (~5 Hz): punches show up live, no hold.
+// 0.02 V hysteresis on the way back up so it doesn't chatter on a boundary.
+static const uint16_t frogBattThreshCv[FROG_BATT_DEAD] = { 400, 380, 365, 350, 335 };
+
+static frogBattStage_e frogBattStage(void)
+{
+    static frogBattStage_e stage = FROG_BATT_FULL;
+    const batteryState_e state = getBatteryState();
+    if (state == BATTERY_NOT_PRESENT || state == BATTERY_INIT) {
+        stage = FROG_BATT_FULL;
+        return stage;
+    }
+#if defined(USE_BATTERY_VOLTAGE_SAG_COMPENSATION)
+    uint16_t cell = getBatterySagCellVoltage();
+    if (cell == 0) {
+        cell = getBatteryAverageCellVoltage();
+    }
+#else
+    const uint16_t cell = getBatteryAverageCellVoltage();
+#endif
+    if (cell == 0) {
+        return stage;
+    }
+    frogBattStage_e target = FROG_BATT_DEAD;
+    for (int i = 0; i < FROG_BATT_DEAD; i++) {
+        if (cell >= frogBattThreshCv[i]) {
+            target = (frogBattStage_e)i;
+            break;
+        }
+    }
+    if (target < stage) {
+        // recovering: only step up once clearly above the threshold
+        while (target < stage && cell >= frogBattThreshCv[stage - 1] + 2) {
+            stage = (frogBattStage_e)(stage - 1);
+        }
+    } else {
+        stage = target;                  // dropping: immediate
+    }
+    return stage;
+}
+
+// colour for a battery readout character at a given stage and time
+static uint8_t frogBattSeverity(frogBattStage_e st, int i, timeMs_t now)
+{
+    switch (st) {
+    case FROG_BATT_LOW:
+        return ((now / 700) % 2) ? DISPLAYPORT_SEVERITY_WARNING : DISPLAYPORT_SEVERITY_NORMAL;      // slow breathe
+    case FROG_BATT_LAND:
+        UNUSED(i);
+        return ((now / 220) % 2) ? DISPLAYPORT_SEVERITY_CRITICAL : DISPLAYPORT_SEVERITY_WARNING;    // whole readout pulses red / amber
+    case FROG_BATT_DEAD:
+        return ((now / 90) % 3) ? DISPLAYPORT_SEVERITY_CRITICAL : DISPLAYPORT_SEVERITY_WARNING;      // flicker
+    default:
+        return DISPLAYPORT_SEVERITY_NORMAL;
+    }
+}
