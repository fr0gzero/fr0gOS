+        pct = (uint8_t)((pct * sinceMs) / 1000);
+    }
+    tfp_sprintf(element->buff, "%d%%", pct);
+    const bool hd = frogHdFont(element->osdDisplayPort);
+    const frogBattStage_e st = (sinceMs < 1000) ? FROG_BATT_FULL : frogBattStage();
+    if (hd) {
+        // bar glyph follows the stage (during charge-up it follows the counting %)
+        static const uint8_t barForStage[] = { 4, 3, 2, 1, 0, 0 };
+        uint8_t level = barForStage[st];
+        if (sinceMs < 1000) {
+            level = pct >= 88 ? 4 : pct >= 63 ? 3 : pct >= 38 ? 2 : pct >= 13 ? 1 : 0;
+        }
+        bool barOn = true;
+        if (st == FROG_BATT_LAND) {
+            barOn = (now / 300) % 2;
+        } else if (st == FROG_BATT_DEAD) {
+            barOn = (now / 100) % 2;
+        }
+        const size_t len = strlen(element->buff);
+        element->buff[len] = barOn ? (char)(FROG_GLYPH_BATT0 + level) : ' ';
+        element->buff[len + 1] = '\0';
+        const uint32_t r = frogRand();
+        const int scramble = (st == FROG_BATT_DEAD && (r & 1)) ? (int)((r >> 1) % len) : -1;
+        for (size_t i = 0; i < len; i++) {
+            const uint8_t sev = frogBattSeverity(st, (int)i, now);
+            element->buff[i] = ((int)i == scramble) ? (char)frogColourNoiseChar(DISPLAYPORT_SEVERITY_CRITICAL)
+                                                    : (char)frogColourChar((uint8_t)element->buff[i], sev);
+        }
+    } else {
+        // analog (mono): LAND blinks the %, DEAD also scrambles a character. Only its own text.
+        const size_t len = strlen(element->buff);
+        if (st == FROG_BATT_LAND && (now / 300) % 2) {
+            element->buff[len - 1] = ' ';
+        } else if (st == FROG_BATT_DEAD) {
+            if ((now / 120) % 2) {
+                element->buff[len - 1] = ' ';
+            }
+            if (frogRand() & 1) {
+                element->buff[frogRand() % len] = (char)frogNoiseChar(false);
+            }
+        }
+    }
+    element->attr = DISPLAYPORT_SEVERITY_NORMAL;
+}
+
+uint8_t frogWarnSeverity = DISPLAYPORT_SEVERITY_NORMAL;   // set by the warnings element, read by the frog
+
+// "FROG0" + blinking cursor (left top)
+// ---------------- fr0gOS activity feed (top left, two lines) ----------------
+// What the pilot is doing, for the viewer: the newest event types in through glyphs on the top line and
+// stays until the next one; the previous one drops to the second line. Battery and temperature stay out
+// (they have their own readouts).
+//   switches  ANGLE HORZN ACRO  AIR NOAIR  ARMED SAFE  TURTL  BEEP  packet rate  VTX power
+//   flying    PUNCH (full throttle)  ROLL FLIP SPIN (a full 360 on that axis)
+//   hits      3.6G! (big G)  CRASH (huge spike)  RECRD (new best G)
+//   alerts    link / failsafe / arming warnings (RXLOS, FSAFE, LQ!...)
+#define FROG_FEED_LEN 5
+#define FROG_FEED_LINES 5
+#define FROG_FEED_HOLD_MS 4000     // each message stays 4 s, then disintegrates into glyphs, then nothing
+#define FROG_FEED_OUT_MS  300
+typedef struct {
+    char text[FROG_FEED_LEN + 1];
+    uint8_t sev;
+    timeMs_t at;
+} frogFeedEvent_t;
+static frogFeedEvent_t frogFeed[FROG_FEED_LINES];   // [0] newest (top row), older pushed down
+static timeMs_t frogFeedAt = 0;
+
+// ---------------- the frog ----------------
+// It lives on "ledges": the empty row right above a group of readouts, sitting over the inner edge of the
+// readout below it (the T of THR, the V of 3.71V). It moves by hopping one cell at a time (a hop is a pair of
+// glyphs straddling two cells). To change row or side it hops off the outer edge of the screen and comes back
+// in from the edge on the new row. What it does, most important first:
+//   upside down (turtle, or inverted 0.4 s+)  spins onto its back, holds 1 s+ looking around and kicking
+//   pulling high G                            squashes flat, springs back
+//   feed events                               ARMED SAFE mode-hop PUNCH FLIP/ROLL SPIN CRASH RECORD
+//   low battery                               goes to the voltage ledge and jumps with a red !
+//   disarmed (after a flight)                 eyes closed
+//   otherwise                                 rests (blink, look around, smile), wanders every 15-20 s
+#define FROG_MAX_LEDGES   8
+// each phase lasts two OSD frames at 20 fps, so every frame of the hop is actually seen
+#define FROG_HOP_CROUCH   100
+#define FROG_HOP_STEP     100
+#define FROG_HOP_LAND     100
+#define FROG_HOP_MS       (FROG_HOP_CROUCH + 3 * FROG_HOP_STEP + FROG_HOP_LAND)
+#define FROG_OFFSCREEN_MS 250
+#define FROG_INVERT_MS    400      // inverted this long before it flips (a quick flip trick doesn't count)
+#define FROG_FLIP_HOLD_MS 1000
+#define FROG_SQUASH_MIN_MS 300
+
+static uint8_t frogCols = 50, frogRowsN = 18;
+static uint8_t frogItemLen[OSD_ITEM_COUNT];          // last drawn width of each element: where the ledges are
+
+typedef struct {
+    int8_t x, y;
+    uint8_t item;          // the readout under it
+} frogLedge_t;
+static frogLedge_t frogLedges[FROG_MAX_LEDGES];
+static uint8_t frogLedgeCount = 0;
+static timeMs_t frogLedgesAt = 0;
+
+typedef enum { FROG_PH_NONE = 0, FROG_PH_IN, FROG_PH_HOLD, FROG_PH_OUT } frogPhase_e;
+
+static struct {
+    bool init;
+    int8_t x, y;               // cell it is in (x may be -1 or cols while it is off-screen)
+    bool hopping;
+    int8_t dir;
+    timeMs_t hopAt;
+    bool travelling;
+    int8_t tx, ty;             // destination ledge cell
+    int8_t ledge;              // ledge it sits on (-1 = none)
+    uint8_t anim;              // what it plays while sitting
+    timeMs_t animAt;
+    uint8_t animPrio;          // 0 = idle stuff, >0 = an event reaction
+    uint8_t pending, pendingPrio;
+    bool sleeping, playedSafe;
+    timeMs_t invertedSince;
+    frogPhase_e flip, squash;
+    timeMs_t phaseAt;
+    timeMs_t nextWander;
+} frog;
+
+static uint32_t frogAnimTotal(uint8_t anim)
+{
+    uint32_t t = 0;
+    for (int i = 0; i < frogAnims[anim].n; i++) {
+        t += frogAnims[anim].f[i].t10 * 10;
+    }
+    return t;
+}
+
+// glyph of an animation `ms` in; past the end it loops or holds the last frame
+uint8_t frogAnimGlyph(uint8_t anim, uint32_t ms, bool loop)
+{
+    const frogAnim_t *a = &frogAnims[anim];
+    const uint32_t total = frogAnimTotal(anim);
+    if (ms >= total) {
+        if (!loop) {
+            return a->f[a->n - 1].g;
+        }
+        ms %= total;
+    }
+    for (int i = 0; i < a->n; i++) {
+        const uint32_t t = a->f[i].t10 * 10;
+        if (ms < t) {
+            return a->f[i].g;
+        }
+        ms -= t;
+    }
+    return a->f[a->n - 1].g;
+}
+
+static bool frogAnimDone(uint8_t anim, timeMs_t at, timeMs_t now)
+{
+    return now - at >= frogAnimTotal(anim);
+}
+
+// one hop, `t` ms in, from cell x to x + dir: fills up to two cells, returns how many
+static int frogHopCells(uint32_t t, int x, int dir, uint32_t crouch, uint32_t step, uint32_t land, int *cx, uint8_t *cg)
+{
+    if (t < crouch) {
+        cx[0] = x; cg[0] = FROG_G_CROUCH;
+        return 1;
+    }
+    t -= crouch;
+    if (t < 3 * step) {
+        const int k = t / step;
+        const uint8_t (*pairs)[2] = dir > 0 ? frogHopR : frogHopL;
+        cx[0] = x;       cg[0] = pairs[k][0];
+        cx[1] = x + dir; cg[1] = pairs[k][1];
+        return 2;
+    }
+    (void)land;
+    cx[0] = x + dir; cg[0] = FROG_G_LAND;
+    return 1;
+}
+
+// which rows each side's readouts use, as bitmasks (bit n = row n). One pass over the layout.
+static void frogBusyRows(uint32_t *left, uint32_t *right)
+{
+    *left = *right = 0;
+    for (int i = 0; i < OSD_ITEM_COUNT; i++) {
+        const uint16_t pos = osdElementConfig()->item_pos[i];
+        if (!VISIBLE(pos) || i == OSD_FROG_GLITCH) {
+            continue;
+        }
+        const int x = OSD_X(pos), y = OSD_Y(pos);
+        const bool isRight = x >= frogCols - FROG_EDGE_ZONE;
+        if (x >= FROG_EDGE_ZONE && !isRight) {
+            continue;
+        }
+        uint32_t rows;
+        if (i == OSD_FROG_TAG) {
+            rows = ((1u << FROG_FEED_LINES) - 1) << (y + 1);   // the feed lines (the frog row itself is free)
+        } else if (i == OSD_THROTTLE_POS || i == OSD_ESC_RPM) {
+            rows = 3u << y;                                   // labelled readouts use two rows
+        } else {
+            rows = 1u << y;
+        }
+        *(isRight ? right : left) |= rows;
+    }
+}
+
+// ledges from the live layout: home (the feed's frog row), then the free row above each edge readout
+static void frogFindLedges(void)
+{
+    frogLedgeCount = 0;
+    uint32_t busyL, busyR;
+    frogBusyRows(&busyL, &busyR);
+    const uint16_t tag = osdElementConfig()->item_pos[OSD_FROG_TAG];
+    if (VISIBLE(tag)) {
+        const int x = OSD_X(tag) + FROG_FEED_LEN - 1;
+        frogLedges[frogLedgeCount++] = (frogLedge_t){ .x = (int8_t)MIN(x, frogCols - 1), .y = (int8_t)OSD_Y(tag), .item = OSD_FROG_TAG };
+    }
+    for (int i = 0; i < OSD_ITEM_COUNT && frogLedgeCount < FROG_MAX_LEDGES; i++) {
+        const uint16_t pos = osdElementConfig()->item_pos[i];
+        if (!VISIBLE(pos) || i == OSD_FROG_TAG || i == OSD_FROG_GLITCH || !frogItemLen[i]) {
+            continue;
+        }
+        const int x = OSD_X(pos), y = OSD_Y(pos);
+        const bool right = x >= frogCols - FROG_EDGE_ZONE;
+        if ((x >= FROG_EDGE_ZONE && !right) || y < 1 || ((right ? busyR : busyL) & (1u << (y - 1)))) {
+            continue;
+        }
+        const int len = MIN(frogItemLen[i], FROG_EDGE_ZONE);
+        const int lx = right ? frogCols - len : len - 1;
+        bool dup = false;
+        for (int k = 0; k < frogLedgeCount; k++) {
+            dup = dup || (frogLedges[k].y == y - 1 && (frogLedges[k].x >= frogCols / 2) == right);
+        }
+        if (!dup) {
+            frogLedges[frogLedgeCount++] = (frogLedge_t){ .x = (int8_t)lx, .y = (int8_t)(y - 1), .item = (uint8_t)i };
+        }
+    }
+}
+
+static int frogVoltageLedge(void)
+{
+    for (int k = 0; k < frogLedgeCount; k++) {
+        if (frogLedges[k].item == OSD_MAIN_BATT_VOLTAGE || frogLedges[k].item == OSD_AVG_CELL_VOLTAGE) {
+            return k;
+        }
+    }
+    return -1;
+}
+
+static void frogGoTo(int k, timeMs_t now)
+{
+    if (k < 0 || k >= frogLedgeCount || (k == frog.ledge && !frog.travelling)) {
+        return;
+    }
+    frog.tx = frogLedges[k].x;
+    frog.ty = frogLedges[k].y;
+    frog.ledge = k;
+    frog.travelling = true;
+    frog.hopAt = now;                       // if it is off-screen, it waits FROG_OFFSCREEN_MS from here
+}
+
+static void frogPlay(uint8_t anim, uint8_t prio, timeMs_t now)
+{
+    frog.anim = anim;
+    frog.animAt = now;
+    frog.animPrio = prio;
+}
+
+// feed events the frog reacts to; anything else (warnings, rates, BEEP, 3.6G!) it ignores
+static void frogReact(const char *text)
+{
+    static const struct { const char *text; uint8_t anim, prio; } map[] = {
+        { "CRASH", FROG_ANIM_CRASH, 6 }, { "RECRD", FROG_ANIM_RECORD, 5 },
+        { "FLIP", FROG_ANIM_TRICK, 4 },  { "ROLL", FROG_ANIM_TRICK, 4 }, { "SPIN", FROG_ANIM_SPIN, 4 },
+        { "ARMED", FROG_ANIM_ARMED, 3 }, { "SAFE", FROG_ANIM_SAFE, 3 },
+        { "PUNCH", FROG_ANIM_PUNCH, 2 }, { "ZOOM", FROG_ANIM_PUNCH, 2 }, { "PERCH", FROG_ANIM_FIL_SMILE, 2 },
+        { "ACRO", FROG_ANIM_MODE, 1 }, { "ANGLE", FROG_ANIM_MODE, 1 }, { "HORZN", FROG_ANIM_MODE, 1 },
+        { "AIR", FROG_ANIM_MODE, 1 },  { "NOAIR", FROG_ANIM_MODE, 1 },
+    };
+    for (unsigned i = 0; i < ARRAYLEN(map); i++) {
+        if (strcmp(text, map[i].text) == 0) {
+            if (map[i].anim == FROG_ANIM_ARMED) {
+                frog.sleeping = false;
+            }
+            if (map[i].prio >= frog.pendingPrio) {
+                frog.pending = map[i].anim;
+                frog.pendingPrio = map[i].prio;
+            }
+            return;
+        }
+    }
+}
+
+static bool frogUpsideDown(timeMs_t now)
+{
+    bool inverted = false;
+#if defined(USE_ACC)
+    inverted = sensors(SENSOR_ACC) && getCosTiltAngle() < 0.0f;          // tilted past 90 degrees
+#endif
+    if (!inverted) {
+        frog.invertedSince = 0;
+    } else if (!frog.invertedSince) {
+        frog.invertedSince = now ? now : 1;
+    }
+    return isCrashFlipModeActive() || (frog.invertedSince && now - frog.invertedSince >= FROG_INVERT_MS);
+}
+
+// the frog only runs to the voltage when it's getting real: 3.44 V a cell or less for 1.5 s (a punch that sags
+// it for a moment doesn't count); it stays there until the pack is back above 3.52 V for 3 s
+#define FROG_BATT_GO_CV      344
+#define FROG_BATT_GO_MS      1500
+#define FROG_BATT_BACK_CV    352
+#define FROG_BATT_BACK_MS    3000
+static bool frogBattLowForFrog(timeMs_t now)
+{
+    static bool low = false;
+    static timeMs_t since = 0;
+    const batteryState_e state = getBatteryState();
+    const uint16_t cell = getBatteryAverageCellVoltage();
+    if (state == BATTERY_NOT_PRESENT || state == BATTERY_INIT || cell == 0) {
+        low = false;
+        since = 0;
+        return false;
+    }
+    const bool crossing = low ? cell >= FROG_BATT_BACK_CV : cell <= FROG_BATT_GO_CV;
+    if (!crossing) {
+        since = 0;
+    } else if (!since) {
+        since = now ? now : 1;
+    } else if (now - since >= (low ? FROG_BATT_BACK_MS : FROG_BATT_GO_MS)) {
+        low = !low;
+        since = 0;
+    }
+    return low;
+}
+
+static void frogStartHop(int dir, timeMs_t now)
+{
+    frog.dir = dir;
+    frog.hopping = true;
+    frog.hopAt = now;
+}
+
+// one OSD frame of the frog: up to two cells (x, glyph); returns how many are on screen
+static int frogTick(timeMs_t now, int *cx, uint8_t *cg)
+{
+    // ledges: worked out on the ground (the layout doesn't change in flight), kept cheap so this element
+    // never looks slow to the scheduler
+    if (!frogLedgesAt || (!ARMING_FLAG(ARMED) && now - frogLedgesAt >= 1000)) {
+        frogLedgesAt = now ? now : 1;
+        frogFindLedges();
+    }
+    if (!frog.init) {
+        frog.init = true;
+        frog.x = frogLedgeCount ? frogLedges[0].x : FROG_FEED_LEN - 1;
+        frog.y = frogLedgeCount ? frogLedges[0].y : 0;
+        frog.ledge = frogLedgeCount ? 0 : -1;
+        frog.pending = 0xFF;
+        frogPlay(FROG_ANIM_REST, 0, now);
+        frog.nextWander = now + 15000 + frogRand() % 5000;
+    }
+    const bool armed = ARMING_FLAG(ARMED);
+    const bool upside = frogUpsideDown(now);
+    const bool squashing = armed && osdGForce >= FROG_HIGH_G;
+    const bool lowBatt = frogBattLowForFrog(now);
+    const bool offscreen = frog.x < 0 || frog.x >= frogCols;
+    const uint32_t cr = FROG_HOP_CROUCH, st = FROG_HOP_STEP, la = FROG_HOP_LAND;
+
+    // 1. in the middle of a hop: finish it
+    if (frog.hopping) {
+        const uint32_t t = now - frog.hopAt;
+        if (t < FROG_HOP_MS) {
+            return frogHopCells(t, frog.x, frog.dir, cr, st, la, cx, cg);
+        }
+        frog.hopping = false;
+        frog.x += frog.dir;
+        frog.hopAt = now;
+        if (frog.x < 0 || frog.x >= frogCols) {
+            return 0;
+        }
+    }
+
+    // 2. off the edge of the screen: come back in on the destination row
+    if (offscreen) {
+        if (!frog.travelling) {
+            frogGoTo(0, now);                       // lost: go home
+            frog.hopAt = now - FROG_OFFSCREEN_MS;
+        }
+        if (now - frog.hopAt >= FROG_OFFSCREEN_MS) {
+            const bool right = frog.tx >= frogCols / 2;
+            frog.x = right ? frogCols : -1;
+            frog.y = frog.ty;
+            frogStartHop(right ? -1 : 1, now);       // its first frame is still off-screen
+        }
+        return 0;
+    }
+
+    // 3. sitting: the most important thing wins
+    if (upside || frog.flip != FROG_PH_NONE) {
+        if (frog.flip == FROG_PH_NONE || (frog.flip == FROG_PH_OUT && upside)) {
+            frog.flip = frog.flip == FROG_PH_OUT ? FROG_PH_HOLD : FROG_PH_IN;
+            frog.phaseAt = now;
+        }
+        if (frog.flip == FROG_PH_IN && frogAnimDone(FROG_ANIM_FLIP_IN, frog.phaseAt, now)) {
+            frog.flip = FROG_PH_HOLD;
+            frog.phaseAt = now;
+        }
+        if (frog.flip == FROG_PH_HOLD && !upside && now - frog.phaseAt >= FROG_FLIP_HOLD_MS) {
+            frog.flip = FROG_PH_OUT;
+            frog.phaseAt = now;
+        }
+        if (frog.flip == FROG_PH_OUT && frogAnimDone(FROG_ANIM_FLIP_OUT, frog.phaseAt, now)) {
+            frog.flip = FROG_PH_NONE;
+            frogPlay(FROG_ANIM_REST, 0, now);
+        } else {
+            const uint8_t a = frog.flip == FROG_PH_IN ? FROG_ANIM_FLIP_IN : frog.flip == FROG_PH_HOLD ? FROG_ANIM_FLIP_HOLD : FROG_ANIM_FLIP_OUT;
+            cx[0] = frog.x;
+            cg[0] = frogAnimGlyph(a, now - frog.phaseAt, a == FROG_ANIM_FLIP_HOLD);
+            return 1;
+        }
+    }
+    if (squashing || frog.squash != FROG_PH_NONE) {
+        if (frog.squash == FROG_PH_NONE || (frog.squash == FROG_PH_OUT && squashing)) {
+            frog.squash = FROG_PH_IN;
+            frog.phaseAt = now;
+        }
+        if (frog.squash == FROG_PH_IN && frogAnimDone(FROG_ANIM_SQUASH_IN, frog.phaseAt, now)) {
+            frog.squash = FROG_PH_HOLD;
+            frog.phaseAt = now;
+        }
+        if (frog.squash == FROG_PH_HOLD && !squashing && now - frog.phaseAt >= FROG_SQUASH_MIN_MS) {
+            frog.squash = FROG_PH_OUT;
+            frog.phaseAt = now;
+        }
+        if (frog.squash == FROG_PH_OUT && frogAnimDone(FROG_ANIM_SQUASH_OUT, frog.phaseAt, now)) {
+            frog.squash = FROG_PH_NONE;
+        } else {
+            cx[0] = frog.x;
+            cg[0] = frog.squash == FROG_PH_HOLD ? FROG_G_SQUASHED
+                  : frogAnimGlyph(frog.squash == FROG_PH_IN ? FROG_ANIM_SQUASH_IN : FROG_ANIM_SQUASH_OUT, now - frog.phaseAt, false);
+            return 1;
+        }
+    }
+    // event reactions: a stronger one cuts in, otherwise it waits its turn
+    if (frog.pending != 0xFF && (frog.animPrio == 0 || frog.pendingPrio > frog.animPrio || frogAnimDone(frog.anim, frog.animAt, now))) {
+        frogPlay(frog.pending, frog.pendingPrio, now);
+        frog.playedSafe = frog.pending == FROG_ANIM_SAFE;
+        frog.pending = 0xFF;
+        frog.pendingPrio = 0;
+    }
+    if (frog.animPrio) {
+        if (!frogAnimDone(frog.anim, frog.animAt, now)) {
+            cx[0] = frog.x;
+            cg[0] = frogAnimGlyph(frog.anim, now - frog.animAt, false);
+            return 1;
+        }
+        if (frog.playedSafe) {
+            frog.sleeping = !armed;                 // eyes stay closed until the next arm
+            frog.playedSafe = false;
+        }
+        frogPlay(FROG_ANIM_REST, 0, now);
+    }
+    // on its way somewhere: next hop
+    if (frog.travelling && frog.x == frog.tx && frog.y == frog.ty) {
+        frog.travelling = false;
+        frog.nextWander = now + 15000 + frogRand() % 5000;
+    }
+    if (frog.travelling) {
+        const bool sameSide = (frog.x >= frogCols / 2) == (frog.tx >= frogCols / 2);
+        int dir;
+        if (frog.y == frog.ty && sameSide) {
+            dir = frog.tx > frog.x ? 1 : -1;
+        } else {
+            dir = frog.x >= frogCols / 2 ? 1 : -1;  // to the outer edge, and off it
+        }
+        frogStartHop(dir, now);
+        return frogHopCells(0, frog.x, dir, cr, st, la, cx, cg);
+    }
+    // low battery: to the voltage readout, then jump up and down there
+    if (lowBatt) {
+        const int k = frogVoltageLedge();
+        if (k >= 0 && (frog.x != frogLedges[k].x || frog.y != frogLedges[k].y)) {
+            frog.ledge = -1;
+            frogGoTo(k, now);
+            return frogTick(now, cx, cg);
+        }
+        if (frog.anim != FROG_ANIM_LOWBATT) {
+            frogPlay(FROG_ANIM_LOWBATT, 0, now);
+        }
+        cx[0] = frog.x;
+        cg[0] = frogAnimGlyph(FROG_ANIM_LOWBATT, now - frog.animAt, true);
+        return 1;
+    }
+    if (frog.anim == FROG_ANIM_LOWBATT) {
+        frogPlay(FROG_ANIM_REST, 0, now);
+    }
+    if (frog.sleeping) {
+        cx[0] = frog.x;
+        cg[0] = FROG_G_SLEEPY;
+        return 1;
+    }
+    // wander to another ledge every 15-20 s
+    if (frogLedgeCount > 1 && cmp32(now, frog.nextWander) >= 0) {
+        int k = frogRand() % (frogLedgeCount - 1);
+        if (k >= frog.ledge && frog.ledge >= 0) {
+            k++;
+        }
+        frogGoTo(k, now);
+        frog.nextWander = now + 15000 + frogRand() % 5000;
+        return frogTick(now, cx, cg);
+    }
+    // rest (blink, look around, smile), over and over
+    if (frogAnimDone(frog.anim, frog.animAt, now)) {
+        frogPlay(FROG_ANIM_REST, 0, now);
+    }
+    cx[0] = frog.x;
+    cg[0] = frogAnimGlyph(frog.anim, now - frog.animAt, false);
+    return 1;
+}
+
+// the boot screen frog: CRT power-on at the start of the header, hops along it to its last letter, fills any
+// spare time with random little animations (a different mix every boot), then celebrates when the checks are done
+#define FROG_BOOT_HOP_MS 200
+void frogBootDraw(displayPort_t *dp, uint32_t ms, int x0, int lastX, int row, uint32_t doneMs)
+{
+    static uint8_t fill[12];
+    static const uint8_t fillers[] = { FROG_ANIM_FIL_BLINK, FROG_ANIM_FIL_LOOKL, FROG_ANIM_FIL_LOOKR,
+                                       FROG_ANIM_FIL_LOOKUP, FROG_ANIM_FIL_SMILE, FROG_ANIM_FIL_DANCE };
+    if (ms < 50 || !fill[0]) {
+        for (unsigned i = 0; i < ARRAYLEN(fill); i++) {
+            fill[i] = fillers[frogRand() % ARRAYLEN(fillers)];
+        }
+    }
+    int cx[2] = { x0, x0 };
+    uint8_t cg[2] = { FROG_G_IDLE, 0 };
+    int n = 1;
+    const uint32_t crt = frogAnimTotal(FROG_ANIM_CRT);
+    const uint32_t hopsEnd = crt + (uint32_t)MAX(0, lastX - x0) * FROG_BOOT_HOP_MS;
+    if (ms < crt) {
+        cg[0] = frogAnimGlyph(FROG_ANIM_CRT, ms, false);
+    } else if (ms < hopsEnd) {
+        const uint32_t t = ms - crt;
+        n = frogHopCells(t % FROG_BOOT_HOP_MS, x0 + t / FROG_BOOT_HOP_MS, 1, 40, 40, 40, cx, cg);
+    } else {
+        cx[0] = lastX;
+        uint32_t t = hopsEnd;
+        unsigned i = 0;
+        bool done = false;
+        while (t < doneMs) {                        // early: fillers until the checks are done
+            const uint32_t d = frogAnimTotal(fill[i % ARRAYLEN(fill)]);
+            if (ms < t + d) {
+                cg[0] = frogAnimGlyph(fill[i % ARRAYLEN(fill)], ms - t, false);
+                done = true;
+                break;
+            }
+            t += d;
+            i++;
+        }
+        if (!done) {
+            const uint32_t c = ms - t;
+            cg[0] = c < frogAnimTotal(FROG_ANIM_CELEBRATE) ? frogAnimGlyph(FROG_ANIM_CELEBRATE, c, false)
+                  : frogAnimGlyph(FROG_ANIM_REST, c - frogAnimTotal(FROG_ANIM_CELEBRATE), true);
+        }
+    }
+    // the whole frog row is rewritten each time, so the cell it left is cleared
+    char b[40];
+    const int from = MAX(0, x0 - 1);
+    const int to = MIN((int)dp->cols - 1, lastX + 2);
+    int len = 0;
+    for (int x = from; x <= to && len < (int)sizeof(b) - 1; x++) {
+        char c = ' ';
+        for (int k = 0; k < n; k++) {
+            if (cx[k] == x) {
+                c = (char)cg[k];
+            }
+        }
+        b[len++] = c;
+    }
+    b[len] = '\0';
+    displayWrite(dp, from, row, DISPLAYPORT_SEVERITY_NORMAL, b);
+}
+
+// fr0gOS boot length: CRT + hops + celebration, so osd.c can hold the boot screen long enough
+uint32_t frogBootLengthMs(int hops, uint32_t doneMs)
+{
+    const uint32_t hopsEnd = frogAnimTotal(FROG_ANIM_CRT) + (uint32_t)MAX(0, hops) * FROG_BOOT_HOP_MS;
+    // worst case a filler starts just before doneMs
+    return MAX(hopsEnd, doneMs + 900) + frogAnimTotal(FROG_ANIM_CELEBRATE) + 300;
+}
+
+// combo meter, under the event log: every event that lands within 5 s of the previous one disappearing
+// (4 s on screen + 0.3 s disintegrating + 5 s) keeps the chain going: X2, X3 ... X99. Only counts while armed;
+// disarming or a gap ends it (the number disintegrates).
+#define FROG_COMBO_WINDOW_MS (FROG_FEED_HOLD_MS + FROG_FEED_OUT_MS + 5000)
+#define FROG_COMBO_BUMP_MS   260
+#define FROG_COMBO_OUT_MS    400
+static uint8_t frogCombo = 0;
+static uint8_t frogComboFinal = 0;
+static timeMs_t frogComboLastAt = 0;
+static timeMs_t frogComboBumpAt = 0;
+static timeMs_t frogComboEndAt = 0;
+
+static void frogComboEnd(timeMs_t now)
+{
+    if (frogCombo >= 2) {
+        frogComboFinal = frogCombo;
+        frogComboEndAt = now ? now : 1;
+    }
+    frogCombo = 0;
+}
+
+static void frogComboEvent(const char *text, timeMs_t now)
+{
+    if (!ARMING_FLAG(ARMED) || strcmp(text, "SAFE") == 0) {
+        frogComboEnd(now);
+        return;
+    }
+    if (strcmp(text, "ARMED") == 0) {
+        return;
+    }
+    if (frogCombo && now - frogComboLastAt <= FROG_COMBO_WINDOW_MS) {
+        if (frogCombo < 99) {
+            frogCombo++;
+        }
+        if (frogCombo > frogFlightCombo) {
+            frogFlightCombo = frogCombo;            // for HISCORE.EXE
+        }
+        frogComboBumpAt = now ? now : 1;
+        frogComboEndAt = 0;
+    } else {
+        frogComboEnd(now);
+        frogCombo = 1;
+    }
+    frogComboLastAt = now;
+}
+
+// the combo lines: the count (X2-X4 green, X5-X9 amber, X10+ red with a "!", decoding in on every step up),
+// and under it the word COMBO once the chain reaches X5
+#define FROG_COMBO_WORD_AT 5
+static timeMs_t frogComboWordAt = 0;
+static void frogComboLine(char *b, bool hd, timeMs_t now, bool word)
+{
+    if (frogCombo && now - frogComboLastAt > FROG_COMBO_WINDOW_MS) {
+        frogComboEnd(now);
+    }
+    if (!ARMING_FLAG(ARMED) && frogCombo) {
+        frogComboEnd(now);
+    }
+    const uint8_t n = frogCombo >= 2 ? frogCombo : (frogComboEndAt && now - frogComboEndAt < FROG_COMBO_OUT_MS ? frogComboFinal : 0);
+    if (n < 2) {
+        frogComboEndAt = 0;
+        b[0] = '\0';
+        return;
+    }
+    const uint8_t sev = n >= 10 ? DISPLAYPORT_SEVERITY_CRITICAL : n >= 5 ? DISPLAYPORT_SEVERITY_WARNING : DISPLAYPORT_SEVERITY_NORMAL;
+    const bool ending = frogCombo < 2;
+    uint32_t t = ending ? now - frogComboEndAt : (frogComboBumpAt ? now - frogComboBumpAt : FROG_COMBO_BUMP_MS);
+    if (word) {
+        if (n < FROG_COMBO_WORD_AT) {
+            frogComboWordAt = 0;
+            b[0] = '\0';
+            return;
+        }
+        if (!frogComboWordAt) {
+            frogComboWordAt = now ? now : 1;           // decodes in once, when the chain first hits X5
+        }
+        strcpy(b, "COMBO");
+        if (!ending) {
+            t = now - frogComboWordAt;
+        }
+    } else {
+        tfp_sprintf(b, n >= 10 ? "X%d!" : "X%d", n);
+    }
+    for (int i = 0; b[i]; i++) {
+        const bool scrambled = ending ? (t >= 80u * i) : (t < FROG_COMBO_BUMP_MS - 50u * i);
+        if (scrambled) {
+            b[i] = hd ? (char)frogColourNoiseChar(sev) : (char)frogNoiseChar(false);
+        } else if (hd) {
+            b[i] = (char)frogColourChar((uint8_t)b[i], sev);
+        }
+    }
+}
+
+void frogFeedPost(const char *text, uint8_t sev)
+{
+    if (!text || !text[0]) {
+        return;
+    }
+    const timeMs_t now = millis();
+    frogComboEvent(text, now);
+    if (strncmp(frogFeed[0].text, text, FROG_FEED_LEN) != 0) {
+        // new message pops in at the top and pushes the older ones down (the oldest falls off)
+        for (int i = FROG_FEED_LINES - 1; i > 0; i--) {
+            frogFeed[i] = frogFeed[i - 1];
+        }
+    }
+    strncpy(frogFeed[0].text, text, FROG_FEED_LEN);
+    frogFeed[0].text[FROG_FEED_LEN] = '\0';
+    frogFeed[0].sev = sev;
+    frogFeedAt = now ? now : 1;                 // same event again just replays the type-in
+    frogFeed[0].at = frogFeedAt;
+    frogReact(frogFeed[0].text);
+}
+
+static bool frogFeedIgnored(const char *w)
+{
+    // battery and temperature warnings have their own readouts
+    static const char *const skip[] = { "LOWV", "LAND!", "OVCAP", "BCONT", "!FULL" };
+    for (unsigned i = 0; i < ARRAYLEN(skip); i++) {
+        if (strcmp(w, skip[i]) == 0) {
+            return true;
+        }
+    }
+    return strncmp(w, "HOT", 3) == 0;
+}
+
+// ---- tricks and crashes, watched at IMU rate (the OSD itself only looks ~10-20 times a second) ----
+// A trick is 300 degrees one way on one axis (a "full" 360 with some slack), started and finished within 3 s.
+// It keeps counting through a slow patch of up to 0.5 s; turning back the other way hard starts it over.
+#define FROG_TRICK_DEG       300.0f
+#define FROG_TRICK_RATE      100.0f     // deg/s to count as turning
+#define FROG_TRICK_SLOW_MS   500
+#define FROG_TRICK_MAX_MS    3000
+// Crash vs perch. A hit of 3.8 G+ opens a 0.5 s look: it's a CRASH if the hit was huge (7 G+), or the quad
+// tumbled (500 deg/s+) or ended up tilted past ~45 degrees. Otherwise it was a touchdown. PERCH is posted when
+// the quad comes to rest upright: throttle under 20%, gyro under 40 deg/s and about 1 G for 0.7 s, once per
+// landing (it has to fly again before the next one counts).
+#define FROG_IMPACT_G10      38
+#define FROG_SMASH_G10       70
+#define FROG_BIGG_G10        30
+#define FROG_IMPACT_LOOK_MS  500
+#define FROG_TUMBLE_DPS      500.0f
+#define FROG_UPRIGHT_COS     0.7f
+#define FROG_PERCH_DPS       40.0f
+#define FROG_PERCH_THR       20
+#define FROG_PERCH_MS        700
+#define FROG_EV_CRASH        0x08
+#define FROG_EV_PERCH        0x10
+static uint8_t frogTrickPending = 0;    // bit 0 roll, 1 flip (pitch), 2 spin (yaw), FROG_EV_CRASH, FROG_EV_PERCH
+static uint16_t frogPeakG10 = 0;        // peak G since the last look, below the impact level (for "3.4G!")
+static timeUs_t frogMotionArmedAt = 0;
+static bool frogMotionFresh = false;
+
+void frogMotionTick(timeUs_t nowUs)
+{
+    static timeUs_t last = 0;
+    static float deg[3];
+    static timeUs_t startAt[3], slowAt[3];
+    const float peak = frogAccPeakG;
+    frogAccPeakG = 0.0f;
+    if (!ARMING_FLAG(ARMED) || isCrashFlipModeActive()) {
+        deg[0] = deg[1] = deg[2] = 0.0f;
+        last = 0;
+        frogMotionArmedAt = 0;
+        return;
+    }
+    if (!frogMotionArmedAt) {
+        frogMotionArmedAt = nowUs ? nowUs : 1;
+        frogMotionFresh = true;            // just armed: on the ground, not perched anywhere yet
+    }
+    const uint16_t g10 = (uint16_t)lrintf(peak * 10.0f);
+    const float maxRate = MAX(fabsf(gyro.gyroADCf[0]), MAX(fabsf(gyro.gyroADCf[1]), fabsf(gyro.gyroADCf[2])));
+    static timeUs_t impactAt = 0, stillSince = 0;
+    static uint16_t impactG10 = 0;
+    static float impactRate = 0.0f;
+    static bool perched = true;            // on the ground until it has flown
+    if (frogMotionFresh) {
+        perched = true;
+        impactAt = 0;
+        impactG10 = 0;
+        stillSince = 0;
+        frogMotionFresh = false;
+    }
+#if defined(USE_ACC)
+    const bool upright = getCosTiltAngle() >= FROG_UPRIGHT_COS;
+#else
+    const bool upright = true;
+#endif
+    const int thr = calculateThrottlePercent();
+    // impact: look for 0.5 s, then decide crash or touchdown
+    if (g10 >= FROG_IMPACT_G10) {
+        if (!impactAt) {
+            impactAt = nowUs ? nowUs : 1;
+            impactRate = 0.0f;
+        }
+        impactG10 = MAX(impactG10, g10);
+    } else if (g10 > frogPeakG10) {
+        frogPeakG10 = g10;
+    }
+    if (impactAt) {
+        impactRate = MAX(impactRate, maxRate);
+        if (cmpTimeUs(nowUs, impactAt) >= FROG_IMPACT_LOOK_MS * 1000) {
+            if (impactG10 >= FROG_SMASH_G10 || impactRate >= FROG_TUMBLE_DPS || !upright) {
+                frogTrickPending |= FROG_EV_CRASH;
+                perched = true;            // a crash isn't a perch
+            } else {
+                frogPeakG10 = MAX(frogPeakG10, impactG10);   // a hard touchdown: just the G message
+            }
+            impactAt = 0;
+            impactG10 = 0;
+        }
+    }
+    // perch: settled, upright, throttle down, after flying
+    const bool still = upright && thr < FROG_PERCH_THR && maxRate < FROG_PERCH_DPS && peak > 0.8f && peak < 1.2f;
+    if (!still) {
+        stillSince = 0;
+        if (thr >= 30 || maxRate >= 150.0f) {
+            perched = false;               // flying again
+        }
+    } else if (!stillSince) {
+        stillSince = nowUs ? nowUs : 1;
+    } else if (!perched && !impactAt && cmpTimeUs(nowUs, stillSince) >= FROG_PERCH_MS * 1000) {
+        frogTrickPending |= FROG_EV_PERCH;
+        perched = true;
+    }
+    const float dt = last ? cmpTimeUs(nowUs, last) * 1e-6f : 0.0f;
+    last = nowUs;
+    if (dt <= 0.0f || dt > 0.1f) {
+        deg[0] = deg[1] = deg[2] = 0.0f;
+        return;
+    }
+    for (int axis = 0; axis < 3; axis++) {
+        const float rate = gyro.gyroADCf[axis];
+        const bool turning = fabsf(rate) >= FROG_TRICK_RATE;
+        if (deg[axis] == 0.0f) {
+            if (turning) {
+                startAt[axis] = nowUs;
+                slowAt[axis] = 0;
+                deg[axis] = rate * dt;
+            }
+            continue;
+        }
+        if (turning && (rate > 0) != (deg[axis] > 0)) {
+            startAt[axis] = nowUs;               // hard the other way: start over in that direction
+            slowAt[axis] = 0;
+            deg[axis] = rate * dt;
+            continue;
+        }
+        if (!turning) {
+            if (!slowAt[axis]) {
+                slowAt[axis] = nowUs;
+            } else if (cmpTimeUs(nowUs, slowAt[axis]) > FROG_TRICK_SLOW_MS * 1000) {
+                deg[axis] = 0.0f;
+                continue;
+            }
+        } else {
+            slowAt[axis] = 0;
+        }
+        if ((rate > 0) == (deg[axis] > 0)) {
+            deg[axis] += rate * dt;
+        }
+        if (cmpTimeUs(nowUs, startAt[axis]) > FROG_TRICK_MAX_MS * 1000) {
+            deg[axis] = 0.0f;
+        } else if (fabsf(deg[axis]) >= FROG_TRICK_DEG) {
+            frogTrickPending |= 1 << axis;
+            deg[axis] = 0.0f;
+        }
+    }
+}
+
+static void frogFeedDetect(timeMs_t now)
+{
+    static bool init = false;
+    static bool armed, air, flip, beep;
+    static uint8_t mode;                       // 0 acro, 1 angle, 2 horizon
+    static timeMs_t punchCool, gCool, fullSince;
+    static bool punchHeld, zoomed;
+
+    const bool nowArmed = ARMING_FLAG(ARMED);
+    const bool nowAir = isAirmodeEnabled();
+    const bool nowFlip = isCrashFlipModeActive();
+    const uint8_t nowMode = FLIGHT_MODE(ANGLE_MODE) ? 1 : FLIGHT_MODE(HORIZON_MODE) ? 2 : 0;
+    const bool nowBeep = IS_RC_MODE_ACTIVE(BOXBEEPERON);
+    if (!init) {
+        // first look: learn the current state silently
+        armed = nowArmed; air = nowAir; flip = nowFlip; mode = nowMode; beep = nowBeep;
+        init = true;
+        return;
+    }
+
+    if (nowArmed != armed) {
+        armed = nowArmed;
+        frogFeedPost(nowArmed ? "ARMED" : "SAFE", DISPLAYPORT_SEVERITY_NORMAL);
+    }
+    if (nowFlip != flip) {
+        flip = nowFlip;
+        if (nowFlip) {
+            frogFeedPost("TURTL", DISPLAYPORT_SEVERITY_CRITICAL);
+        }
+    }
+    if (nowMode != mode) {
+        mode = nowMode;
+        static const char *const names[] = { "ACRO", "ANGLE", "HORZN" };
+        frogFeedPost(names[nowMode], DISPLAYPORT_SEVERITY_NORMAL);
+    }
+    if (nowAir != air) {
+        air = nowAir;
+        frogFeedPost(nowAir ? "AIR" : "NOAIR", DISPLAYPORT_SEVERITY_NORMAL);
+    }
+    if (nowBeep != beep) {
+        beep = nowBeep;
+        if (nowBeep) {
+            frogFeedPost("BEEP", DISPLAYPORT_SEVERITY_WARNING);
+        }
+    }
+    if (!nowArmed) {
+        frogTrickPending = 0;
+        frogPeakG10 = 0;
+        fullSince = 0;
+        return;
+    }
+
+    // throttle: PUNCH on the way up past 90% (re-arms once you drop under 70%)
+    const int thr = calculateThrottlePercent();
+    if (thr >= 90) {
+        if (!punchHeld && cmp32(now, punchCool) >= 0) {
+            frogFeedPost("PUNCH", DISPLAYPORT_SEVERITY_WARNING);
+            punchCool = now + 1500;
+        }
+        punchHeld = true;
+    } else if (thr < 70) {
+        punchHeld = false;
+    }
+    // ZOOM: full throttle (95%+) held for more than a second, once per hold
+    if (thr >= 95) {
+        if (!fullSince) {
+            fullSince = now ? now : 1;
+        } else if (!zoomed && now - fullSince > 1000) {
+            frogFeedPost("ZOOM", DISPLAYPORT_SEVERITY_WARNING);
+            zoomed = true;
+        }
+    } else {
+        fullSince = 0;
+        zoomed = false;
+    }
+#if defined(USE_ACC)
+    // G: big hit, crash (peak G since the last look, sampled at full rate so short hits aren't missed)
+    const int peak10 = frogPeakG10;
+    frogPeakG10 = 0;
+    if (frogTrickPending & FROG_EV_CRASH) {
+        frogFeedPost("CRASH", DISPLAYPORT_SEVERITY_CRITICAL);
+        gCool = now + 2000;
+    } else if (peak10 >= FROG_BIGG_G10 && cmp32(now, gCool) >= 0) {
+        char t[8];
+        tfp_sprintf(t, "%d.%dG!", peak10 / 10, peak10 % 10);
+        frogFeedPost(t, DISPLAYPORT_SEVERITY_WARNING);
+        gCool = now + 1500;
+    }
+#endif
+
+    // tricks found by frogMotionTick since the last look
+    static const char *const tricks[3] = { "ROLL", "FLIP", "SPIN" };
+    const uint8_t pending = frogTrickPending;
+    frogTrickPending = 0;
+    for (int axis = 0; axis < 3; axis++) {
+        if (pending & (1 << axis)) {
+            frogFeedPost(tricks[axis], DISPLAYPORT_SEVERITY_NORMAL);
+        }
+    }
+    if (pending & FROG_EV_PERCH) {
+        frogFeedPost("PERCH", DISPLAYPORT_SEVERITY_NORMAL);
+    }
 }
 
+// frog on row 0 (HD), then five event lines (newest on top), drawn as repeated calls of the same element
+static void frogFeedLine(char *b, const frogFeedEvent_t *ev, bool newest, bool hd, timeMs_t now)
+{
+    const char *txt = ev->text;
+    const int n = strlen(txt);
+    const uint32_t age = ev->at ? now - ev->at : 1000000;
+    int i = 0;
+    if (!n || age >= FROG_FEED_HOLD_MS + FROG_FEED_OUT_MS) {
+        b[0] = '\0';
+        return;
+    }
+    if (age >= FROG_FEED_HOLD_MS) {
+        // glyph out: characters turn to glyphs and drop out left to right
+        const uint32_t t = age - FROG_FEED_HOLD_MS;
+        for (; i < n; i++) {
+            b[i] = (txt[i] == ' ' || t >= 60 + 45 * (uint32_t)i) ? ' ' : (char)frogNoiseChar(hd);
+        }
+        b[i] = '\0';
+        return;
+    }
+    if (newest) {
+        // type-in: each character flashes as a glyph for 60 ms before it lands, cursor rides the front
+        for (; i < n; i++) {
+            const uint32_t at = 45 * i;
+            if (age < at) {
+                break;
+            }
+            uint8_t c = (uint8_t)txt[i];
+            if (age < at + 60 && c != ' ') {
+                c = frogNoiseChar(hd);
+            } else if (hd) {
+                c = frogColourChar(c, age < 2500 ? ev->sev : DISPLAYPORT_SEVERITY_NORMAL);
+            }
+            b[i] = (char)c;
+        }
+        if (i < n) {
+            b[i++] = hd ? (char)FROG_GLYPH_CURSOR : '_';
+        }
+    } else {
+        // older messages, pushed down one row each time a new one arrives
+        for (; i < n; i++) {
+            b[i] = txt[i];
+        }
+    }
+    b[i] = '\0';
+}
+
+
+// same rhythm as the ARMED message: glyphs for 0.4 s, then the characters land left to right 45 ms apart;
+// going away, they turn to glyphs and drop out left to right
+#define FROG_FX_IN_MS   400
+#define FROG_FX_STEP_MS 45
+#define FROG_FX_OUT_MS  150
+
+// ---------------- song cues ----------------
+// A song's cue points are baked in (tools/make_song.py -> frog_song.h). The SONG switch (mode USER1) starts the
+// cue clock; the radio starts the song with the same switch, so they stay in sync. Turning it off stops it.
+//   DROP     amber "DROP IN 3 2 1" (one tick apart), then a red DROP
+//   BIGDROP  red "BIG DROP IN 3 2 1", then >>>DROP<<< swapping red / amber, held longer
+//   CHORUS   amber CHORUS        BUILD  green BUILD with growing dots
+//   END      green OUTRO         TEXT   your own words, green
+// Everything decodes in and out like the ARMED message.
+typedef enum { FROG_CUE_NONE = 0, FROG_CUE_DROP, FROG_CUE_BIGDROP, FROG_CUE_CHORUS, FROG_CUE_BUILD, FROG_CUE_END, FROG_CUE_TEXT } frogCueKind_e;
+typedef struct {
+    uint32_t ms;
+    uint8_t kind;
+    char label[10];
+} frogCue_t;
+#define FROG_SONG_TABLES
+#include "osd/frog_song.h"
+
+#define FROG_SONG_TITLE_MS 2500
+#define FROG_SONG_COUNT    3
+
+static timeMs_t frogSongStart = 0;
+
+static uint32_t frogCueHold(uint8_t kind)
+{
+    switch (kind) {
+    case FROG_CUE_DROP:    return 1800;
+    case FROG_CUE_BIGDROP: return 3000;
+    case FROG_CUE_END:     return 3000;
+    default:               return 2200;
+    }
+}
+
+// decode in (glyphs, then land left to right) and, in the last 0.4 s of `hold`, out again
+static void frogSongDecode(char *b, uint32_t t, uint32_t hold, uint8_t sev, bool hd)
+{
+    const int32_t outT = (int32_t)t - (int32_t)(hold > 400 ? hold - 400 : 0);
+    for (int i = 0; b[i]; i++) {
+        if (b[i] == ' ') {
+            continue;
+        }
+        if (outT >= 0 && outT >= FROG_FX_STEP_MS * i + FROG_FX_OUT_MS) {
+            b[i] = ' ';
+        } else if ((outT >= 0 && outT >= FROG_FX_STEP_MS * i) || t < 250u + FROG_FX_STEP_MS * i) {
+            b[i] = hd ? (char)frogColourNoiseChar(sev) : (char)frogNoiseChar(false);
+        } else if (hd) {
+            b[i] = (char)frogColourChar((uint8_t)b[i], sev);
+        }
+    }
+}
+
+// the text to show `t` ms into the song (empty when nothing's due); *x / *y where to put it
+static void frogSongLine(char *b, bool hd, timeMs_t now, int *x, int *y)
+{
+    b[0] = '\0';
+    const bool on = IS_RC_MODE_ACTIVE(BOXUSER1);
+    if (!on) {
+        frogSongStart = 0;
+        return;
+    }
+    if (!frogSongStart) {
+        frogSongStart = now ? now : 1;
+    }
+    const uint32_t t = now - frogSongStart;
+    uint8_t sev = DISPLAYPORT_SEVERITY_NORMAL;
+    bool found = false;
+    // a cue going off right now
+    for (int i = 0; i < FROG_SONG_CUES && !found; i++) {
+        const frogCue_t *c = &frogSongCues[i];
+        const uint32_t hold = frogCueHold(c->kind);
+        if (c->kind == FROG_CUE_NONE || t < c->ms || t >= c->ms + hold) {
+            continue;
+        }
+        const uint32_t ct = t - c->ms;
+        found = true;
+        switch (c->kind) {
+        case FROG_CUE_DROP:
+            strcpy(b, "DROP");
+            sev = DISPLAYPORT_SEVERITY_CRITICAL;
+            break;
+        case FROG_CUE_BIGDROP:
+            strcpy(b, ">>>DROP<<<");
+            sev = ((ct / 250) % 2) ? DISPLAYPORT_SEVERITY_WARNING : DISPLAYPORT_SEVERITY_CRITICAL;
+            break;
+        case FROG_CUE_CHORUS:
+            strcpy(b, c->label);
+            sev = DISPLAYPORT_SEVERITY_WARNING;
+            break;
+        case FROG_CUE_BUILD:
+            tfp_sprintf(b, "%s%s", c->label, &"..."[3 - MIN(3, (int)(ct / 400))]);
+            break;
+        default:
+            strcpy(b, c->label);
+            break;
+        }
+        frogSongDecode(b, ct, hold, sev, hd);
+    }
+    // a drop coming up: count it in
+    for (int i = 0; i < FROG_SONG_CUES && !found; i++) {
+        const frogCue_t *c = &frogSongCues[i];
+        const uint32_t lead = FROG_SONG_COUNT * FROG_SONG_TICK_MS;
+        if ((c->kind != FROG_CUE_DROP && c->kind != FROG_CUE_BIGDROP) || t >= c->ms || c->ms - t > lead) {
+            continue;
+        }
+        const uint32_t left = c->ms - t;
+        const int n = (left + FROG_SONG_TICK_MS - 1) / FROG_SONG_TICK_MS;     // 3, 2, 1
+        const uint32_t tickT = FROG_SONG_TICK_MS - (left - (n - 1) * FROG_SONG_TICK_MS);
+        const bool big = c->kind == FROG_CUE_BIGDROP;
+        tfp_sprintf(b, big ? "BIG DROP IN %d" : "DROP IN %d", n);
+        sev = big ? DISPLAYPORT_SEVERITY_CRITICAL : DISPLAYPORT_SEVERITY_WARNING;
+        const int len = strlen(b);
+        // the words decode in once (on 3), the number decodes on every tick
+        const uint32_t sinceStart = lead - left;
+        for (int k = 0; k < len; k++) {
+            const bool digit = k == len - 1;
+            const bool scrambled = digit ? tickT < 180 : sinceStart < 250u + FROG_FX_STEP_MS * k;
+            if (b[k] == ' ') {
+                continue;
+            }
+            if (scrambled) {
+                b[k] = hd ? (char)frogColourNoiseChar(sev) : (char)frogNoiseChar(false);
+            } else if (hd) {
+                b[k] = (char)frogColourChar((uint8_t)b[k], sev);
+            }
+        }
+        found = true;
+    }
+    // the song title as it starts
+    if (!found && t < FROG_SONG_TITLE_MS) {
+        tfp_sprintf(b, "> %s", FROG_SONG_TITLE);
+        frogSongDecode(b, t, FROG_SONG_TITLE_MS, DISPLAYPORT_SEVERITY_NORMAL, hd);
+        found = true;
+    }
+    if (!found) {
+        return;
+    }
+    // trim trailing blanks (decoded out) so the centring doesn't jump
+    const int cols = frogCols, rows = frogRowsN;
+    int len = strlen(b);
+    *x = MAX(FROG_EDGE_ZONE, cols / 2 - len / 2);
+    *y = MAX(1, rows / 2 - 5);
+}
+
+static void osdElementFrogTag(osdElementParms_t *element)
+{
+    static uint8_t call = 0;
+    const bool hd = frogHdFont(element->osdDisplayPort);
+    const timeMs_t now = millis();
+    const uint8_t frogRows = hd ? 1 : 0;           // analog has no frog glyph: events start on row 0
+
+    if (call == 0) {
+        frogCols = element->osdDisplayPort->cols;
+        frogRowsN = element->osdDisplayPort->rows;
+        frogFeedDetect(now);
+    }
+    if (call < frogRows) {
+        // the frog: one or two cells (two while it is mid-hop)
+        int cx[2];
+        uint8_t cg[2];
+        const int n = frogTick(now, cx, cg);
+        int left = 99, right = -1;
+        for (int k = 0; k < n; k++) {
+            if (cx[k] >= 0 && cx[k] < frogCols) {
+                left = MIN(left, cx[k]);
+                right = MAX(right, cx[k]);
+            }
+        }
+        int len = 0;
+        for (int x = left; x <= right; x++) {
+            char c = ' ';
+            for (int k = 0; k < n; k++) {
+                if (cx[k] == x) {
+                    c = (char)cg[k];
+                }
+            }
+            element->buff[len++] = c;
+        }
+        element->buff[len] = '\0';
+        // the edge zones are justified to the screen edge: anchor on the outer end of the text
+        const int anchor = (len && right >= frogCols - FROG_EDGE_ZONE) ? right : left;
+        if (!len || anchor < element->elemPosX || frog.y < element->elemPosY) {
+            element->buff[0] = '\0';
+            element->elemOffsetX = 0;
+            element->elemOffsetY = 0;
+        } else {
+            element->elemOffsetX = anchor - element->elemPosX;
+            element->elemOffsetY = frog.y - element->elemPosY;
+        }
+    } else if (call < frogRows + FROG_FEED_LINES) {
+        frogFeedLine(element->buff, &frogFeed[call - frogRows], call == frogRows, hd, now);
+        element->elemOffsetX = 0;
+        element->elemOffsetY = call;
+    } else if (call < frogRows + FROG_FEED_LINES + 2) {
+        // the combo meter: the count on the line under the log, COMBO under that from X5
+        frogComboLine(element->buff, hd, now, call > frogRows + FROG_FEED_LINES);
+        element->elemOffsetX = 0;
+        element->elemOffsetY = call;
+    } else {
+        // song cues: centred in the upper middle of the picture
+        int sx = 0, sy = 0;
+        frogSongLine(element->buff, hd, now, &sx, &sy);
+        element->elemOffsetX = MAX(0, sx - element->elemPosX);
+        element->elemOffsetY = MAX(0, sy - element->elemPosY);
+        if (!element->elemOffsetX && !element->elemOffsetY) {
+            element->buff[0] = '\0';
+        }
+    }
+    if (++call < frogRows + FROG_FEED_LINES + 3) {
+        element->rendered = false;
+    } else {
+        call = 0;
+    }
+}
